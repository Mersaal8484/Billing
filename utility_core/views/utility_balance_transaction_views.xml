<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_balance_transaction_tree" model="ir.ui.view">
        <field name="name">utility.customer.balance.transaction.tree</field>
        <field name="model">utility.customer.balance.transaction</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'cancelled'" decoration-success="state == 'posted'">
                <field name="reference"/>
                <field name="date"/>
                <field name="customer_id"/>
                <field name="transaction_type"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="balance_before" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="balance_after" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge"/>
                <field name="operator_id"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_balance_transaction_form" model="ir.ui.view">
        <field name="name">utility.customer.balance.transaction.form</field>
        <field name="model">utility.customer.balance.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="ترحيل"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_cancel" type="object" string="إلغاء"
                            attrs="{'invisible': [('state', 'in', ('posted', 'cancelled'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="date"/>
                            <field name="customer_id"/>
                            <field name="transaction_type"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="balance_before" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="balance_after" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="state" widget="badge"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                        <field name="operator_id"/>
                        <field name="source_model"/>
                        <field name="source_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_utility_balance_transaction_search" model="ir.ui.view">
        <field name="name">utility.customer.balance.transaction.search</field>
        <field name="model">utility.customer.balance.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="customer_id"/>
                <field name="transaction_type"/>
                <filter name="posted" string="مرحّل" domain="[('state','=','posted')]"/>
                <filter name="draft" string="مسودة" domain="[('state','=','draft')]"/>
                <filter name="cancelled" string="ملغى" domain="[('state','=','cancelled')]"/>
                <group expand="0" string="تصنيف حسب">
                    <filter name="group_state" string="الحالة" context="{'group_by':'state'}"/>
                    <filter name="group_type" string="النوع" context="{'group_by':'transaction_type'}"/>
                    <filter name="group_customer" string="الحساب" context="{'group_by':'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_balance_transaction" model="ir.actions.act_window">
        <field name="name">حركات الرصيد</field>
        <field name="res_model">utility.customer.balance.transaction</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_utility_balance_transaction_search"/>
    </record>
</odoo>
