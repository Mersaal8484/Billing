<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_team_tree" model="ir.ui.view">
        <field name="name">utility.team.tree</field>
        <field name="model">utility.team</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="team_leader_id"/>
                <field name="member_count"/>
                <field name="area_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_utility_team_form" model="ir.ui.view">
        <field name="name">utility.team.form</field>
        <field name="model">utility.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="team_leader_id"/>
                            <field name="member_count"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="region_id"/>
                            <field name="area_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="members" string="Members">
                            <field name="staff_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="employee_code"/>
                                    <field name="user_role_id"/>
                                    <field name="mobile"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_utility_team_search" model="ir.ui.view">
        <field name="name">utility.team.search</field>
        <field name="model">utility.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="team_leader_id"/>
                <field name="area_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_area" string="Area" context="{'group_by':'area_id'}"/>
                    <filter name="group_region" string="Region" context="{'group_by':'region_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_utility_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">utility.team</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_utility_team_search"/>
    </record>
</odoo>
