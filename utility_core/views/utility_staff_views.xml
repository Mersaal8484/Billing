<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_staff_tree" model="ir.ui.view">
        <field name="name">utility.staff.tree</field>
        <field name="model">utility.staff</field>
        <field name="arch" type="xml">
            <tree decoration-success="active == True" decoration-muted="active == False">
                <field name="name"/>
                <field name="employee_code"/>
                <field name="user_role_id" optional="show"/>
                <field name="team_id" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="mobile" optional="hide"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="view_utility_staff_form" model="ir.ui.view">
        <field name="name">utility.staff.form</field>
        <field name="model">utility.staff</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="active" invisible="1"/>
                    <button name="toggle_active" type="object"
                            attrs="{'invisible': [('active', '=', True)]}"
                            string="تفعيل" class="btn-success"/>
                    <button name="toggle_active" type="object"
                            attrs="{'invisible': [('active', '=', False)]}"
                            string="تعطيل" class="btn-danger"/>
                </header>
                <sheet>

                    <div class="oe_title">
                        <label for="name" string="الاسم"/>
                        <h1><field name="name" placeholder="اسم الموظف"/></h1>
                    </div>
                    <group>
                        <group name="identity" string="معلومات أساسية">
                            <field name="employee_code" placeholder="رمز الموظف"/>
                            <field name="team_id" options="{'no_create': True}"/>
                            <field name="user_role_id" options="{'no_create': True}"/>
                        </group>
                        <group name="contact" string="معلومات الاتصال">
                            <field name="phone" placeholder="رقم الهاتف"/>
                            <field name="mobile" placeholder="رقم الجوال"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="account" string="الحساب">
                            <group>
                                <group>
                                    <field name="user_id" options="{'no_create': True}"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                                <group>
                                    <field name="active"/>
                                </group>
                            </group>
                            <separator string="المجموعات المرتبطة بالدور"/>
                            <field name="user_role_id" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="group_ids" widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_utility_staff_search" model="ir.ui.view">
        <field name="name">utility.staff.search</field>
        <field name="model">utility.staff</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_code"/>
                <field name="user_role_id"/>
                <field name="team_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user_role_id" string="Role" context="{'group_by':'user_role_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by':'team_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_utility_staff" model="ir.actions.act_window">
        <field name="name">الموظفون</field>
        <field name="res_model">utility.staff</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_utility_staff_search"/>
    </record>
</odoo>
