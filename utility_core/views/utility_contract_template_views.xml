<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_contract_template_tree" model="ir.ui.view">
        <field name="name">utility.contract.template.tree</field>
        <field name="model">utility.contract.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="recurring_rule_type"/>
                <field name="recurring_invoicing_type"/>
                <field name="recurring_interval"/>
                <field name="tariff_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_contract_template_form" model="ir.ui.view">
        <field name="name">utility.contract.template.form</field>
        <field name="model">utility.contract.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="اسم القالب"/>
                        <h1>
                            <field name="name" placeholder="مثال: عقد سكني دوري..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="التهيئة الأساسية">
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="قواعد التكرار">
                            <field name="recurring_rule_type"/>
                            <field name="recurring_invoicing_type"/>
                            <field name="recurring_interval"/>
                        </group>
                    </group>
                    <group string="الإعدادات الافتراضية وسير العمل">
                        <group>
                            <field name="pricelist_id"/>
                            <field name="journal_id"/>
                            <field name="tariff_id"/>
                        </group>
                        <group>
                            <field name="sale_autoconfirm"/>
                            <field name="create_invoice_automatically"/>
                            <field name="validate_invoice_automatically"/>
                        </group>
                    </group>
                    <group string="الدفع التلقائي">
                        <field name="is_auto_pay"/>
                        <field name="auto_pay_retries" invisible="not is_auto_pay"/>
                        <field name="auto_pay_retry_hours" invisible="not is_auto_pay"/>
                    </group>
                    <notebook>
                        <page string="بنود العقد">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_type"/>
                                    <field name="specific_price"/>
                                    <field name="meter_line_type"/>
                                    <field name="qty_formula_id"/>
                                    <field name="is_subsidized"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_utility_contract_template" model="ir.actions.act_window">
        <field name="name">قوالب العقود</field>
        <field name="res_model">utility.contract.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
