<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_transformer_reading_tree" model="ir.ui.view">
        <field name="name">utility.transformer.reading.tree</field>
        <field name="model">utility.transformer.reading</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'cancelled'" decoration-success="state == 'confirmed'">
                <field name="name"/>
                <field name="transformer_id"/>
                <field name="meter_id"/>
                <field name="reading_type"/>
                <field name="customer_id"/>
                <field name="reading_date"/>
                <field name="reading_value"/>
                <field name="consumption"/>
                <field name="date_range_id"/>
                <field name="image_state" widget="badge"/>
                <field name="create_uid" string="القارئ (الاسم)"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_transformer_reading_form" model="ir.ui.view">
        <field name="name">utility.transformer.reading.form</field>
        <field name="model">utility.transformer.reading</field>
        <field name="arch" type="xml">
            <form string="قراءة المحول/الخلية">
                <header>
                    <button name="action_confirm" type="object" string="تأكيد" class="oe_highlight" states="draft"/>
                    <button name="action_cancel" type="object" string="إلغاء" class="btn-danger" states="draft,confirmed"/>
                    <button name="action_draft" type="object" string="إعادة للمسودة" states="cancelled"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="معلومات القراءة">
                            <field name="transformer_id" options="{'no_create': True}"/>
                            <field name="meter_id" options="{'no_create': True}" domain="[('transformer_id', '=', transformer_id)]"/>
                            <field name="reading_type"/>
                            <field name="customer_id" options="{'no_create': True}" attrs="{'invisible': [('reading_type', '!=', 'cell')], 'required': [('reading_type', '=', 'cell')]}"/>
                        </group>
                        <group string="بيانات العداد">
                            <field name="reading_date"/>
                            <field name="reading_value"/>
                            <field name="previous_reading" readonly="1"/>
                            <field name="previous_reading_date" readonly="1"/>
                            <field name="consumption" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="صورة عداد الربط/الخلية">
                            <field name="coupling_meter_image" widget="image" options="{'size': [200, 150]}"/>
                            <field name="image_state"/>
                            <field name="attachment_id" readonly="1" groups="base.group_no_one"/>
                        </group>
                        <group string="معلومات إضافية">
                            <field name="date_range_id" options="{'no_create': True}"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ===================== KANBAN VIEW ===================== -->
    <record id="view_utility_transformer_reading_kanban" model="ir.ui.view">
        <field name="name">utility.transformer.reading.kanban</field>
        <field name="model">utility.transformer.reading</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="transformer_id"/>
                <field name="meter_id"/>
                <field name="reading_value"/>
                <field name="reading_type"/>
                <field name="state"/>
                <field name="coupling_meter_image"/>
                <field name="create_uid"/>
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{kanban_image('utility.transformer.reading', 'coupling_meter_image', record.id.raw_value)}')">
                                <img class="o_kanban_image_inner_pic" t-if="record.coupling_meter_image.raw_value" t-att-alt="record.name.value" t-att-src="kanban_image('utility.transformer.reading', 'coupling_meter_image', record.id.raw_value)"/>
                            </div>
                            <div class="o_kanban_image d-md-none" t-attf-style="background-image:url('#{kanban_image('utility.transformer.reading', 'coupling_meter_image', record.id.raw_value)}')">
                                <img class="o_kanban_image_inner_pic" t-if="record.coupling_meter_image.raw_value" t-att-alt="record.name.value" t-att-src="kanban_image('utility.transformer.reading', 'coupling_meter_image', record.id.raw_value)"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a role="menuitem" type="edit" class="dropdown-item">تعديل</a>
                                            <a role="menuitem" type="delete" class="dropdown-item">حذف</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>المحول/الخلية: <field name="transformer_id"/></div>
                                    <div>العداد: <field name="meter_id"/> (<field name="reading_type"/>)</div>
                                    <div>القراءة: <field name="reading_value"/></div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        القارئ: <field name="create_uid"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'confirmed': 'success', 'cancelled': 'danger'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_utility_transformer_reading_search" model="ir.ui.view">
        <field name="name">utility.transformer.reading.search</field>
        <field name="model">utility.transformer.reading</field>
        <field name="arch" type="xml">
            <search>
                <field name="transformer_id"/>
                <field name="meter_id"/>
                <field name="customer_id"/>
                <field name="reading_date"/>
                <field name="date_range_id"/>
                <filter name="coupling" string="عدادات الربط" domain="[('reading_type','=','coupling')]"/>
                <filter name="cell" string="الخلايا/المشتركين" domain="[('reading_type','=','cell')]"/>
                <filter name="confirmed" string="مؤكدة" domain="[('state','=','confirmed')]"/>
                <filter name="draft" string="مسودة" domain="[('state','=','draft')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_transformer" string="المحول" context="{'group_by':'transformer_id'}"/>
                    <filter name="group_type" string="نوع القراءة" context="{'group_by':'reading_type'}"/>
                    <filter name="group_period" string="الفترة" context="{'group_by':'date_range_id'}"/>
                    <filter name="group_image_state" string="حالة الصورة" context="{'group_by':'image_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_transformer_reading" model="ir.actions.act_window">
        <field name="name">قراءات المحولات والخلايا</field>
        <field name="res_model">utility.transformer.reading</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_utility_transformer_reading_search"/>
        <field name="help">قراءات عدادات المحولات (الربط) وقراءات الخلايا/المشتركين التابعة للمحول مع التوثيق بالصور.</field>
    </record>

    <menuitem id="menu_utility_transformer_readings" name="قراءات المحولات" parent="menu_utility_network" action="action_utility_transformer_reading" sequence="30" groups="utility_core.group_utility_supervisor"/>
</odoo>
