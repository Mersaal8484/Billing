<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_utility_core" model="ir.ui.view">
        <field name="name">res.company.form.utility.core</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="إعدادات الكهرباء والحسابات" name="utility_settings">
                    <group>
                        <group string="الحسابات المحاسبية">
                            <field name="fine_account_id"/>
                            <field name="discount_account_id"/>
                            <field name="deposit_account_id"/>
                            <field name="settlement_account_id"/>
                            <field name="writeoff_account_id"/>
                            <field name="collector_receivable_account_id"/>
                            <field name="collection_clearing_account_id"/>
                            <field name="deposit_clearing_account_id"/>
                            <field name="collection_surplus_account_id"/>
                        </group>
                        <group string="اليوميات">
                            <field name="writeoff_journal_id"/>
                            <field name="deposit_journal_id"/>
                            <field name="settlement_journal_id"/>
                            <field name="collection_journal_id"/>
                            <field name="opening_journal_id"/>
                        </group>
                        <group string="المنتجات الافتراضية">
                            <field name="penalty_product_id"/>
                            <field name="mu_allim_product_id"/>
                            <field name="cleaning_product_id"/>
                            <field name="local_fee_product_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
