<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_account_form_inherit_utility" model="ir.ui.view">
        <field name="name">account.analytic.account.form.inherit.utility</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="تفاصيل حساب الكهرباء" invisible="not utility_account_id">
                        <group>
                            <group string="معلومات الاشتراك">
                                <field name="utility_account_id" readonly="1"/>
                                <field name="utility_customer_id" readonly="1"/>
                                <field name="contract_state" readonly="1"/>
                            </group>
                            <group string="تفاصيل العداد والقراءات">
                                <field name="meter_id" readonly="1"/>
                                <field name="meter_type" readonly="1"/>
                                <field name="meter_vastype" readonly="1"/>
                                <field name="meter_current_reading" readonly="1"/>
                                <field name="meter_last_invo_reading" readonly="1"/>
                            </group>
                        </group>
                        <group string="معلومات الشبكة والموقع">
                            <group>
                                <field name="region_id" readonly="1"/>
                                <field name="area_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="transformer_id" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
