<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_utility_meter_log_tree" model="ir.ui.view">
        <field name="name">utility.meter.log.tree</field>
        <field name="model">utility.meter.log</field>
        <field name="arch" type="xml">
            <tree default_order="date desc" create="0" edit="0" delete="0">
                <field name="date" />
                <field name="meter_id" />
                <field name="log_type" widget="badge" />
                <field name="description" />
                <field name="customer_id" />
                <field name="user_id" />
            </tree>
        </field>
    </record>
    <record id="view_utility_meter_log_form" model="ir.ui.view">
        <field name="name">utility.meter.log.form</field>
        <field name="model">utility.meter.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" string="سجل العداد">
                <sheet>
                    <widget name="web_ribbon" title="مؤرشف" bg_color="bg-info"/>
                    <div class="oe_title">
                        <label for="meter_id" class="oe_edit_only" string="العداد"/>
                        <h1>
                            <field name="meter_id" />
                        </h1>
                        <h2>
                            <field name="log_type" class="text-primary"/>
                        </h2>
                    </div>
                    <group>
                        <group string="معلومات الحدث">
                            <field name="date" />
                            <field name="user_id" />
                        </group>
                        <group string="التفاصيل الإضافية">
                            <field name="customer_id" />
                            <field name="ref_name" />
                            <field name="ref_model" invisible="1"/>
                            <field name="ref_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="التفاصيل والملاحظات">
                            <field name="description" placeholder="تفاصيل الحدث..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_utility_meter_log_search" model="ir.ui.view">
        <field name="name">utility.meter.log.search</field>
        <field name="model">utility.meter.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="meter_id" />
                <field name="log_type" />
                <field name="customer_id" />
                <filter string="آخر 30 يوم" name="last_30_days" domain="[('date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%%Y-%%m-%%d'))]" />
                <group expand="0" string="Group By">
                    <filter string="نوع الحدث" name="group_by_log_type" context="{'group_by':'log_type'}" />
                    <filter string="العداد" name="group_by_meter" context="{'group_by':'meter_id'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="action_utility_meter_log" model="ir.actions.act_window">
        <field name="name">سجل حركات العدادات</field>
        <field name="res_model">utility.meter.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_by_meter': 1}</field>
    </record>
</odoo>
