<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_users_form_inherit_utility" model="ir.ui.view">
        <field name="name">res.users.form.inherit.utility</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="utility_collection" string="إدارة تحصيل الكهرباء">
                    <group>
                        <group string="إعدادات التحصيل النقدية">
                            <field name="collection_journal_id" options="{'no_create': True}" placeholder="اختر اليومية النقدية"/>
                            <field name="collector_block_code" placeholder="مثال: A, B, C..."/>
                            <field name="prevent_installment"/>
                        </group>
                        <group string="بيانات النظام القديم (PEC)">
                            <field name="legacy_user_code" placeholder="معرف النظام السابق"/>
                        </group>
                    </group>
                    <group string="المناطق الجغرافية وخطوط السير المعينة">
                        <field name="assigned_region_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="اختر المناطق..."/>
                        <field name="assigned_route_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="اختر خطوط السير..."/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
