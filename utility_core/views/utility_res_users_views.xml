<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_users_form_inherit_utility" model="ir.ui.view">
        <field name="name">res.users.form.inherit.utility</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="utility_collection" string="تحصيل الكهرباء">
                    <group>
                        <field name="collection_journal_id" options="{'no_create': True}"
                               placeholder="اختر اليومية النقدية"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
