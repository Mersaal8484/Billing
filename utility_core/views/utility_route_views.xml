<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_route_tree" model="ir.ui.view">
        <field name="name">utility.route.tree</field>
        <field name="model">utility.route</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="region_id" optional="show"/>
                <field name="area_id"/>
                <field name="zone_id"/>
                <field name="substation_id" optional="show"/>
                <field name="feeder_id" optional="show"/>
                <field name="transformer_id"/>
                <field name="inspector_ids" widget="many2many_tags" optional="show"/>
                <field name="cashier_ids" widget="many2many_tags" optional="show"/>
                <field name="supervisor_id" optional="show"/>
                <field name="customer_count" string="مشتركون" optional="show"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_utility_route_form" model="ir.ui.view">
        <field name="name">utility.route.form</field>
        <field name="model">utility.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_add_customers_wizard" type="object"
                                class="oe_stat_button" icon="fa-plus">
                            <span class="o_stat_text">إضافة مشتركين</span>
                        </button>
                        <button name="action_remove_customers_wizard" type="object"
                                class="oe_stat_button" icon="fa-minus">
                            <span class="o_stat_text">حذف مشتركين</span>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="التسلسل التجاري: region → area → zone → route">
                            <field name="code"/>
                            <field name="region_id"/>
                            <field name="area_id"/>
                            <field name="zone_id"/>
                        </group>
                        <group string="تسلسل التوزيع: substation → feeder → transformer → route">
                            <field name="transformer_id" options="{'no_create': True}"/>
                            <field name="feeder_id"/>
                            <field name="substation_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="إعدادات إضافية">
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="طاقم العمل">
                            <field name="inspector_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="cashier_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="supervisor_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="customers" string="عقود المشتركين">
                            <field name="customer_ids" readonly="1">
                                <tree>
                                    <field name="customer_number"/>
                                    <field name="partner_id"/>
                                    <field name="mobile"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_utility_route_search" model="ir.ui.view">
        <field name="name">utility.route.search</field>
        <field name="model">utility.route</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="region_id"/>
                <field name="area_id"/>
                <field name="zone_id"/>
                <field name="transformer_id"/>
                <field name="substation_id"/>
                <filter name="active" string="نشط" domain="[('active','=',True)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_region" string="المنطقة" context="{'group_by':'region_id'}"/>
                    <filter name="group_area" string="المنطقة الفرعية" context="{'group_by':'area_id'}"/>
                    <filter name="group_zone" string="المنطقة التفصيلية" context="{'group_by':'zone_id'}"/>
                    <filter name="group_transformer" string="المحول" context="{'group_by':'transformer_id'}"/>
                    <filter name="group_substation" string="المحطة" context="{'group_by':'substation_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_utility_route" model="ir.actions.act_window">
        <field name="name">مسارات القراءة</field>
        <field name="res_model">utility.route</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_utility_route_search"/>
    </record>
</odoo>
