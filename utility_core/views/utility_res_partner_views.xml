<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit res.partner form view to add utility fields -->
    <record id="view_partner_form_inherit_utility_core" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.utility.core</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(utility_core.action_utility_customer_wizard)d" type="action" 
                            string="تفعيل كمشترك كهرباء" class="oe_highlight" 
                            attrs="{'invisible': [('is_subscriber', '=', True)]}"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="nickname" placeholder="الاسم المختصر..."/>
                <field name="char_code" placeholder="الرمز التعريفي"/>
                <field name="new_no" placeholder="الرقم الجديد"/>
                <field name="is_subscriber"/>
                <field name="subscriber_status" attrs="{'invisible': [('is_subscriber', '=', False)]}" widget="radio" options="{'horizontal': true}"/>
                <field name="subscriber_active_status" attrs="{'invisible': [('is_subscriber', '=', False)]}" widget="radio" options="{'horizontal': true}"/>
                <field name="subscriber_id" attrs="{'invisible': [('is_subscriber', '=', False)]}" options="{'no_create': True}"/>
                <field name="sector_id" attrs="{'invisible': [('is_subscriber', '=', False)]}" options="{'no_create': True}"/>
                <field name="sale_type" options="{'no_create': True}"/>
            </xpath>

            <notebook position="inside">
                <page name="utility_technical_details" string="البيانات الفنية للكهرباء" attrs="{'invisible': [('is_subscriber', '=', False)]}">
                    <group>
                        <group string="التسلسل الجغرافي للشبكة (NUTS)">
                            <field name="utility_region_id" options="{'no_create': True}"/>
                            <field name="utility_area_id" options="{'no_create': True}"/>
                            <field name="direct_branch_id" options="{'no_create': True}"/>
                            <field name="transformer_zone_id" options="{'no_create': True}"/>
                            <field name="residential_compound_id" options="{'no_create': True}"/>
                            <field name="region_id" options="{'no_create': True}"/>
                            <field name="area_id" options="{'no_create': True}"/>
                            <field name="zone_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="السجل المالي والمحاسبي">
                            <field name="last_payment"/>
                            <field name="last_payment_date"/>
                            <field name="last_invoice"/>
                            <field name="last_invoice_date"/>

                            <field name="previous_hotline_balance"/>
                            <field name="payment_token_ids" invisible="1"/>
                            <field name="payment_token_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                </page>
            </notebook>
        </field>
    </record>


    <record id="action_server_open_utility_customer_registration" model="ir.actions.server">
        <field name="name">إنشاء/فتح حساب كهرباء</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
if len(records) != 1:
    action = {
        'type': 'ir.actions.client',
        'tag': 'display_notification',
        'params': {
            'title': 'Warning',
            'message': 'Please select one partner only.',
            'type': 'warning',
            'sticky': False,
        },
    }
else:
    partner = records[0]
    customer = env['utility.customer'].search([('partner_id', '=', partner.id)], limit=1)
    if customer:
        action = {
            'name': 'Utility Customer',
            'type': 'ir.actions.act_window',
            'res_model': 'utility.customer',
            'views': [(False, 'form')],
            'view_mode': 'form',
            'res_id': customer.id,
            'target': 'current',
        }
    else:
        action = {
            'name': 'Register Utility Customer',
            'type': 'ir.actions.act_window',
            'res_model': 'utility.customer.wizard',
            'views': [(False, 'form')],
            'view_mode': 'form',
            'target': 'new',
            'context': {
                'active_model': 'res.partner',
                'active_id': partner.id,
                'active_ids': [partner.id],
            },
        }
        ]]></field>
    </record>

    <!-- Inherit ir.attachment form view to add custom storage path and URL -->
    <record id="view_attachment_form_inherit_utility" model="ir.ui.view">
        <field name="name">ir.attachment.form.inherit.utility</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mimetype']" position="after">
                <field name="custom_storage_path" readonly="1" groups="base.group_no_one"/>
                <field name="invoice_attachment_url" readonly="1" widget="url" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>
