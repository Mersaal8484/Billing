<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_date_range_type_form_inherit_utility" model="ir.ui.view">
        <field name="name">date.range.type.utility.form</field>
        <field name="model">date.range.type</field>
        <field name="inherit_id" ref="date_range.view_date_range_type_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="parent_type_id"/>
                <field name="fiscal_year"/>
            </field>
        </field>
    </record>

    <record id="view_date_range_form_inherit_utility" model="ir.ui.view">
        <field name="name">date.range.utility.form</field>
        <field name="model">date.range</field>
        <field name="inherit_id" ref="date_range.view_date_range_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="parent_id"/>
                <field name="previous_range_id"/>
                <field name="region_id"/>
                <field name="billing_period"/>
                <field name="work_type"/>
                <field name="is_current_period"/>
            </field>
        </field>
    </record>

    <record id="view_date_range_tree_inherit_utility" model="ir.ui.view">
        <field name="name">date.range.utility.tree</field>
        <field name="model">date.range</field>
        <field name="inherit_id" ref="date_range.view_date_range_tree"/>
        <field name="arch" type="xml">
            <field name="date_start" position="after">
                <field name="region_id" optional="show"/>
                <field name="billing_period" optional="show"/>
            </field>
        </field>
    </record>

    <record id="action_utility_date_range" model="ir.actions.act_window">
        <field name="name">الفترات الزمنية (Date Ranges)</field>
        <field name="res_model">date.range</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_utility_date_range_type" model="ir.actions.act_window">
        <field name="name">أنواع الفترات الزمنية (Date Range Types)</field>
        <field name="res_model">date.range.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_utility_date_range_root" name="Date Ranges" parent="utility_core.menu_utility_config" sequence="85"/>
    <menuitem id="menu_utility_date_range" name="Date Ranges" parent="menu_utility_date_range_root" action="action_utility_date_range" sequence="10"/>
    <menuitem id="menu_utility_date_range_type" name="Date Range Types" parent="menu_utility_date_range_root" action="action_utility_date_range_type" sequence="20"/>
</odoo>
