<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_date_range_type_form_inherit_utility" model="ir.ui.view">
        <field name="name">date.range.type.utility.form</field>
        <field name="model">date.range.type</field>
        <field name="inherit_id" ref="date_range.date_range_type_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="parent_type_id"/>
                <field name="fiscal_year"/>
            </field>
        </field>
    </record>

    <record id="view_date_range_form_inherit_utility" model="ir.ui.view">
        <field name="name">date.range.utility.form</field>
        <field name="model">date.range</field>
        <field name="inherit_id" ref="date_range.date_range_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="parent_id"/>
                <field name="previous_range_id"/>
                <field name="region_id"/>
                <field name="billing_period"/>
                <field name="work_type"/>
                <field name="is_current_period"/>
            </field>
        </field>
    </record>

    <record id="view_date_range_tree_inherit_utility" model="ir.ui.view">
        <field name="name">date.range.utility.tree</field>
        <field name="model">date.range</field>
        <field name="inherit_id" ref="date_range.date_range_tree"/>
        <field name="arch" type="xml">
            <field name="date_start" position="after">
                <field name="region_id" optional="show"/>
                <field name="billing_period" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
