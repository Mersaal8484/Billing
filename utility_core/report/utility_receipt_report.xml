<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <report
        id="action_report_utility_receipt"
        model="utility.customer"
        string="تقرير الإيصال"
        report_type="qweb-pdf"
        name="utility_core.receipt_report"
        file="utility_core.receipt_report"
        print_report_name="'Receipt - %s' % object.account_number"
    />

    <template id="receipt_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <h2>Payment Receipt</h2>
                    <p><strong>Account:</strong> <t t-esc="doc.account_number"/></p>
                    <p><strong>Customer:</strong> <t t-esc="doc.partner_id.name"/></p>
                    <p><strong>Balance:</strong> <t t-esc="doc.balance"/></p>
                    <p><strong>Date:</strong> <t t-esc="doc.last_purchase_date"/></p>
                </div>
            </t>
        </t>
    </template>
</odoo>
