<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_utility_meter_qr_bulk" model="report.paperformat">
        <field name="name">ورق A4 للـ QR</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_utility_meter_qr_bulk" model="ir.actions.report">
        <field name="name">طباعة QR بالجملة للمطبعة</field>
        <field name="model">utility.meter</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">utility_core.report_utility_meter_qr_bulk</field>
        <field name="report_file">utility_core.report_utility_meter_qr_bulk</field>
        <field name="print_report_name">'QR بالجملة - %s' % (time.strftime('%Y-%m-%d'))</field>
        <field name="binding_model_id" ref="utility_core.model_utility_meter"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="utility_core.paperformat_utility_meter_qr_bulk"/>
    </record>

    <template id="report_utility_meter_qr_bulk">
        <t t-call="web.html_container">
            <div class="page" dir="rtl" style="font-family: Tahoma, Arial, sans-serif; text-align:center; color:#000;">
                <t t-foreach="docs" t-as="o">
                    <div style="display:inline-block; width:45mm; height:50mm; margin:2mm; padding:2mm; border:1px dotted #999; vertical-align:top; page-break-inside: avoid; border-radius: 5px;">
                        <div style="font-weight:bold; font-size:10px; margin-bottom:2px;">&#1593;&#1583;&#1575;&#1583;&#32;&#1603;&#1607;&#1585;&#1576;&#1575;&#1569;</div>
                        <img t-if="o.qr_code_image"
                             t-attf-src="data:image/png;base64,{{o.qr_code_image.decode('utf-8')}}"
                             style="width:28mm; height:28mm; display:block; margin:2px auto;" alt="Meter QR"/>
                        <div style="font-weight:bold; margin-top:2px; font-size:10px;" t-esc="o.meter_number or ''"/>
                        <div t-if="o.customer_id" style="font-size:8px; margin-top:1px;" t-esc="o.customer_id.customer_number or ''"/>
                        <div t-if="o._get_physical_serial()" style="font-size:8px;">S/N: <span t-esc="o._get_physical_serial()"/></div>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
