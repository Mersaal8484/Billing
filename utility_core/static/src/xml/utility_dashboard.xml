<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="utility_dashboard.UtilityDashboard" owl="1">
        <div class="utility_dashboard_container">
            <div class="dashboard-header">
                <div class="header-left">
                    <h2>لوحة القيادة الإدارية</h2>
                    <p>ملخص الأداء المالي والتشغيلي حسب المنطقة</p>
                </div>
                <div class="header-right">
                    <label for="region_select">اختر المنطقة:</label>
                    <select id="region_select" t-on-change="onRegionChange" class="region-selector">
                        <option value="">جميع المناطق</option>
                        <t t-foreach="state.regions" t-as="region" t-key="region.id">
                            <option t-att-value="region.id" t-att-selected="state.selectedRegionId === region.id ? 'selected' : false">
                                <t t-esc="region.name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>
            
            <div class="kpi-cards-row">
                <div class="kpi-card kpi-success">
                    <div class="kpi-icon"><i class="fa fa-bolt"></i></div>
                    <div class="kpi-info">
                        <h3><t t-esc="state.kpi.today_prepaid" /> ريال</h3>
                        <p>مبيعات الدفع المسبق (اليوم)</p>
                    </div>
                </div>

                <div class="kpi-card kpi-info-color">
                    <div class="kpi-icon"><i class="fa fa-money"></i></div>
                    <div class="kpi-info">
                        <h3><t t-esc="state.kpi.today_postpaid" /> ريال</h3>
                        <p>تحصيلات الفواتير الآجلة (اليوم)</p>
                    </div>
                </div>

                <div class="kpi-card kpi-danger" t-on-click="openUnpaidInvoices">
                    <div class="kpi-icon"><i class="fa fa-exclamation-triangle"></i></div>
                    <div class="kpi-info">
                        <h3><t t-esc="state.kpi.total_debt" /> ريال</h3>
                        <p>إجمالي المديونية المفتوحة</p>
                    </div>
                </div>

                <div class="kpi-card kpi-primary" t-on-click="openCustomers">
                    <div class="kpi-icon"><i class="fa fa-users"></i></div>
                    <div class="kpi-info">
                        <h3><t t-esc="state.kpi.active_customers" /></h3>
                        <p>إجمالي المشتركين النشطين</p>
                    </div>
                </div>
            </div>

            <div class="region-section">
                <div class="section-title">
                    <h3>المؤشرات حسب المنطقة</h3>
                </div>
                <table class="region-table">
                    <thead>
                        <tr>
                            <th>المنطقة</th>
                            <th>المشتركون النشطون</th>
                            <th>مسبق اليوم</th>
                            <th>آجل اليوم</th>
                            <th>المديونية</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.kpi.region_rows" t-as="row" t-key="row.region_id || 'unassigned'">
                            <tr t-on-click="() => this.openCustomers(row.region_id)">
                                <td><t t-esc="row.region_name" /></td>
                                <td><t t-esc="row.active_customers" /></td>
                                <td><t t-esc="row.today_prepaid" /> ريال</td>
                                <td><t t-esc="row.today_postpaid" /> ريال</td>
                                <td class="debt-cell" t-on-click.stop="() => this.openUnpaidInvoices(row.region_id)"><t t-esc="row.total_debt" /> ريال</td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <div class="dashboard-charts-row">
                <div class="chart-container">
                    <h3>الإصدارات مقابل التحصيلات (آخر 7 أيام)</h3>
                    <div class="canvas-wrapper">
                        <canvas t-ref="chartCanvas"></canvas>
                    </div>
                </div>
                <div class="chart-container">
                    <h3>المشتركون والمديونية حسب المنطقة</h3>
                    <div class="canvas-wrapper">
                        <canvas t-ref="regionChartCanvas"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
