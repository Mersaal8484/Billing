                'mu_allim_product_id': ref('utility_product_mu_allim'),
                'cleaning_product_id': ref('utility_product_cleaning'),
                'local_fee_product_id': ref('utility_product_municipality'),
                'writeoff_account_id': ref('demo_account_discount'),
                'collection_journal_id': ref('demo_journal_writeoff'),
