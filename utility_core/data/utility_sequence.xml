<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_utility_customer" model="ir.sequence">
            <field name="name">تسلسل أرقام المشتركين</field>
            <field name="code">utility.customer</field>
            <field name="prefix">CUS/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>


        <record id="seq_utility_meter" model="ir.sequence">
            <field name="name">تسلسل أرقام العدادات</field>
            <field name="code">utility.meter</field>
            <field name="prefix">MET/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_connection" model="ir.sequence">
            <field name="name">تسلسل أرقام التوصيلات</field>
            <field name="code">utility.connection</field>
            <field name="prefix">CON/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_reading_opening" model="ir.sequence">
            <field name="name">تسلسل القراءات الافتتاحية</field>
            <field name="code">utility.reading.opening</field>
            <field name="prefix">RD-OPN/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_reading_periodic" model="ir.sequence">
            <field name="name">تسلسل القراءات الدورية</field>
            <field name="code">utility.reading.periodic</field>
            <field name="prefix">RD-PER/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_reading_replacement_closing" model="ir.sequence">
            <field name="name">تسلسل قراءات إغلاق الاستبدال</field>
            <field name="code">utility.reading.replacement_closing</field>
            <field name="prefix">RD-CLS/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>


    </data>
</odoo>
