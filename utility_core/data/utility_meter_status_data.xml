<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Operational Meter Statuses -->
        <record id="meter_status_in_service" model="utility.meter.status">
            <field name="name">في الخدمة (In Service)</field>
            <field name="code">in_service</field>
            <field name="sequence">1</field>
        </record>
        <record id="meter_status_disconnected" model="utility.meter.status">
            <field name="name">مفصول (Disconnected)</field>
            <field name="code">disconnected</field>
            <field name="sequence">2</field>
        </record>
        <record id="meter_status_maintenance" model="utility.meter.status">
            <field name="name">قيد الصيانة (Maintenance)</field>
            <field name="code">maintenance</field>
            <field name="sequence">3</field>
        </record>
        <record id="meter_status_faulty" model="utility.meter.status">
            <field name="name">عاطل / معطوب (Faulty)</field>
            <field name="code">faulty</field>
            <field name="sequence">4</field>
        </record>
        <record id="meter_status_retired" model="utility.meter.status">
            <field name="name">خارج الخدمة (Retired)</field>
            <field name="code">retired</field>
            <field name="sequence">5</field>
        </record>
    </data>
</odoo>
