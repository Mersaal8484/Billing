<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_cleanup_utility_cron_history" model="ir.cron">
            <field name="name">إدارة الأتمتة: تنظيف سجلات تنفيذ المهام المجدولة القديمة</field>
            <field name="model_id" ref="model_utility_cron_execution"/>
            <field name="state">code</field>
            <field name="code">model.cron_cleanup_execution_history()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="utility_managed" eval="True"/>
            <field name="utility_code">cron_execution_history_cleanup</field>
            <field name="utility_category">maintenance</field>
            <field name="utility_description">حذف سجلات تنفيذ المهام المجدولة القديمة الأقدم من 90 يوماً لترشيد مساحة قاعدة البيانات</field>
            <field name="prevent_overlap" eval="True"/>
            <field name="allow_manual_run" eval="True"/>
            <field name="batch_size">1000</field>
        </record>
    </data>
</odoo>
