<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Route-based Record Rules for Sale Order (Billing) -->
        <record id="utility_sale_order_route_rule" model="ir.rule">
            <field name="name">Sale Order Route Access Rule</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('utility_core.group_utility_admin') else ['|', ('route_id', '=', False), ('route_id', 'in', user.assigned_route_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('utility_core.group_utility_collector')), (4, ref('utility_core.group_utility_technician'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="utility_service_charge_company_rule" model="ir.rule">
            <field name="name">Service Charge Multi-Company Rule</field>
            <field name="model_id" ref="model_utility_service_charge"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('utility_core.group_utility_billing_manager')), (4, ref('utility_core.group_utility_cashier')), (4, ref('utility_core.group_utility_auditor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="utility_bill_reading_component_company_rule" model="ir.rule">
            <field name="name">Bill Reading Component Multi-Company</field>
            <field name="model_id" ref="model_utility_bill_reading_component"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('utility_core.group_utility_billing_manager')), (4, ref('utility_core.group_utility_auditor'))]"/>
        </record>

        <record id="rule_payment_gateway_transaction_company" model="ir.rule">
            <field name="name">Payment Gateway Transaction Multi-Company Rule</field>
            <field name="model_id" ref="model_utility_payment_gateway_transaction"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
