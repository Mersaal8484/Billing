<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_utility_cashier_shift_tree" model="ir.ui.view">
    <field name="name">utility.cashier.shift.tree</field>
    <field name="model">utility.cashier.shift</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="cashier_id"/>
        <field name="start_time"/>
        <field name="end_time"/>
        <field name="opening_balance" widget="monetary"/>
        <field name="closing_balance" widget="monetary"/>
        <field name="expected_balance" widget="monetary"/>
        <field name="difference" widget="monetary" decoration-danger="difference != 0"/>
        <field name="state" decoration-success="state=='verified'" decoration-info="state=='closed'"/>
      </tree>
    </field>
  </record>

  <record id="view_utility_cashier_shift_form" model="ir.ui.view">
    <field name="name">utility.cashier.shift.form</field>
    <field name="model">utility.cashier.shift</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="open,closed,verified"/>
          <button name="action_close" string="إغلاق الوردية" type="object" states="open" class="btn-primary"/>
          <button name="action_verify" string="تدقيق" type="object" states="closed" class="btn-primary"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" readonly="1"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="cashier_id" options="{'no_create': True}"/>
              <field name="start_time"/>
              <field name="end_time"/>
            </group>
            <group>
              <field name="opening_balance" widget="monetary"/>
              <field name="closing_balance" widget="monetary"/>
              <field name="expected_balance" widget="monetary"/>
              <field name="difference" widget="monetary"/>
            </group>
          </group>
          <group string="ملخص المبيعات">
            <field name="total_sales" widget="monetary"/>
            <field name="total_cash" widget="monetary"/>
          </group>
          <notebook>
            <page name="notes" string="ملاحظات">
              <field name="notes" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
        <div class="oe_chatter">
          <field name="message_ids" widget="mail_thread"/>
        </div>
      </form>
    </field>
  </record>

  <record id="action_utility_cashier_shift" model="ir.actions.act_window">
    <field name="name">الورديات</field>
    <field name="res_model">utility.cashier.shift</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
