<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_utility_receipt" model="ir.actions.report">
        <field name="name">تقرير الإيصال</field>
        <field name="model">utility.customer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">utility_core.receipt_report</field>
        <field name="report_file">utility_core.receipt_report</field>
        <field name="print_report_name">'Receipt - %s' % object.customer_number</field>
    </record>

    <template id="receipt_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <h2>Payment Receipt</h2>
                    <p><strong>Account:</strong> <t t-esc="doc.customer_number"/></p>
                    <p><strong>Customer:</strong> <t t-esc="doc.partner_id.name"/></p>
                    <p><strong>Accounting Balance:</strong> <t t-esc="doc.accounting_balance"/></p>
                    <p><strong>Date:</strong> <t t-esc="doc.last_purchase_date"/></p>
                </div>
            </t>
        </t>
    </template>
</odoo>
