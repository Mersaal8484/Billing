<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_utility_inventory_movement" model="ir.sequence">
            <field name="name">Utility Inventory Movement</field>
            <field name="code">utility.inventory.movement</field>
            <field name="prefix">MOV</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_inventory_count" model="ir.sequence">
            <field name="name">Utility Inventory Count</field>
            <field name="code">utility.inventory.count</field>
            <field name="prefix">CNT</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
