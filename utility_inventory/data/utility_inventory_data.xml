<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="location_warehouse_main" model="utility.inventory.location">
            <field name="name">المستودع الرئيسي</field>
            <field name="code">WH-MAIN</field>
            <field name="location_type">warehouse</field>
        </record>

        <record id="location_warehouse_meters" model="utility.inventory.location">
            <field name="name">مستودع العدادات</field>
            <field name="code">WH-MTR</field>
            <field name="location_type">warehouse</field>
            <field name="parent_id" ref="location_warehouse_main"/>
        </record>

        <record id="location_warehouse_spare_parts" model="utility.inventory.location">
            <field name="name">مستودع قطع الغيار</field>
            <field name="code">WH-SPR</field>
            <field name="location_type">warehouse</field>
            <field name="parent_id" ref="location_warehouse_main"/>
        </record>

        <record id="location_room_meters_single" model="utility.inventory.location">
            <field name="name">غرفة العدادات أحادية الطور</field>
            <field name="code">RM-MTR-S</field>
            <field name="location_type">room</field>
            <field name="parent_id" ref="location_warehouse_meters"/>
        </record>

        <record id="location_room_meters_three" model="utility.inventory.location">
            <field name="name">غرفة العدادات ثلاثية الطور</field>
            <field name="code">RM-MTR-T</field>
            <field name="location_type">room</field>
            <field name="parent_id" ref="location_warehouse_meters"/>
        </record>

        <record id="location_shelf_cables" model="utility.inventory.location">
            <field name="name">رف الكابلات</field>
            <field name="code">SH-CAB</field>
            <field name="location_type">shelf</field>
            <field name="parent_id" ref="location_warehouse_spare_parts"/>
        </record>

        <record id="location_shelf_fuses" model="utility.inventory.location">
            <field name="name">رف الفيوزات والقواطع</field>
            <field name="code">SH-FUS</field>
            <field name="location_type">shelf</field>
            <field name="parent_id" ref="location_warehouse_spare_parts"/>
        </record>

        <!-- ====== منتجات المخزون مع تتبع الأرقام التسلسلية ====== -->
        <record id="product_template_meter_single" model="product.template">
            <field name="name">عداد كهرباء أحادي الطور</field>
            <field name="type">product</field>
            <field name="tracking">serial</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="list_price">8500.00</field>
            <field name="default_code">MTR-SIN-001</field>
            <field name="description">عداد كهرباء أحادي الطور - يتم تتبعه بالرقم التسلسلي</field>
        </record>

        <record id="product_template_meter_three" model="product.template">
            <field name="name">عداد كهرباء ثلاثي الطور</field>
            <field name="type">product</field>
            <field name="tracking">serial</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="list_price">15000.00</field>
            <field name="default_code">MTR-THR-001</field>
            <field name="description">عداد كهرباء ثلاثي الطور - يتم تتبعه بالرقم التسلسلي</field>
        </record>

        <record id="product_template_meter_prepaid" model="product.template">
            <field name="name">عداد كهرباء مسبق الدفع (Prepaid)</field>
            <field name="type">product</field>
            <field name="tracking">serial</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="list_price">12000.00</field>
            <field name="default_code">MTR-PRE-001</field>
            <field name="description">عداد كهرباء مسبق الدفع - يتم تتبعه بالرقم التسلسلي</field>
        </record>

        <!-- ====== منتجات قطع غيار ====== -->
        <record id="product_template_cable" model="product.template">
            <field name="name">كابل كهرباء (متر)</field>
            <field name="type">product</field>
            <field name="tracking">lot</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="list_price">250.00</field>
        </record>

        <record id="product_spare_fuse" model="product.product">
            <field name="name">فيوز كهرباء</field>
            <field name="type">product</field>
            <field name="default_code">SPR-FUS-001</field>
            <field name="list_price">50.00</field>
            <field name="categ_id" ref="product.product_category_all"/>
        </record>

    </data>
</odoo>
