<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_customer_wizard_form_inherit_inventory" model="ir.ui.view">
        <field name="name">utility.customer.wizard.form.inherit.inventory</field>
        <field name="model">utility.customer.wizard</field>
        <field name="inherit_id" ref="utility_core.view_utility_customer_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_meter']" position="after">
                <field name="product_id" attrs="{'invisible': [('create_meter', '=', False)]}" options="{'no_create': True}"/>
                <field name="lot_id" attrs="{'invisible': [('create_meter', '=', False)]}" options="{'no_create': True}" context="{'default_product_id': product_id}"/>
                <field name="lot_condition" attrs="{'invisible': ['|', ('create_meter', '=', False), ('lot_id', '=', False)]}" decoration-success="lot_condition == 'جديد (لم يستخدم من قبل)'" decoration-warning="lot_condition == 'مستعمل/مُجدد'" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='meter_number']" position="attributes">
                <!-- If lot_id is selected, meter_number will be auto-filled and we can optionally make it readonly or just leave it. -->
                <!-- We leave it as is to allow manual override if needed. -->
            </xpath>
        </field>
    </record>
</odoo>
