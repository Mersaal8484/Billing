<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_meter_form_inherit_inventory" model="ir.ui.view">
        <field name="name">utility.meter.form.inherit.inventory</field>
        <field name="model">utility.meter</field>
        <field name="inherit_id" ref="utility_core.view_utility_meter_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='serial_number']" position="before">
                <field name="product_id" options="{'no_create': True}"/>
                <field name="lot_id" options="{'no_create': True}" context="{'default_product_id': product_id}"/>
                <field name="condition"/>
            </xpath>
        </field>
    </record>
</odoo>
