<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_utility_inventory_count_tree" model="ir.ui.view">
            <field name="name">utility.inventory.count.tree</field>
            <field name="model">utility.inventory.count</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="location_id"/>
                    <field name="state"/>
                    <field name="user_id"/>
                </tree>
            </field>
        </record>

        <record id="view_utility_inventory_count_form" model="ir.ui.view">
            <field name="name">utility.inventory.count.form</field>
            <field name="model">utility.inventory.count</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button name="action_start" string="بدء الجرد" type="object"
                                states="draft" class="btn-primary"/>
                        <button name="action_load_items" string="تحميل الأصناف" type="object"
                                states="draft" class="btn-secondary"/>
                        <button name="action_done" string="إتمام الجرد" type="object"
                                states="in_progress" class="btn-primary"/>
                        <button name="action_cancel" string="إلغاء" type="object"
                                states="draft,in_progress" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="date" required="1"/>
                                <field name="location_id" required="1"/>
                            </group>
                            <group>
                                <field name="user_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="بنود الجرد">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="item_id"/>
                                        <field name="expected_quantity"/>
                                        <field name="counted_quantity"/>
                                        <field name="difference"/>
                                        <field name="notes"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="ملاحظات">
                                <group>
                                    <field name="notes" nolabel="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_utility_inventory_count" model="ir.actions.act_window">
            <field name="name">جرد المخزون</field>
            <field name="res_model">utility.inventory.count</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
