<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_utility_inventory_item_tree" model="ir.ui.view">
            <field name="name">utility.inventory.item.tree</field>
            <field name="model">utility.inventory.item</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="location_id"/>
                    <field name="quantity"/>
                    <field name="min_quantity"/>
                    <field name="unit_price"/>
                    <field name="total_value" sum="Total"/>
                </tree>
            </field>
        </record>

        <record id="view_utility_inventory_item_form" model="ir.ui.view">
            <field name="name">utility.inventory.item.form</field>
            <field name="model">utility.inventory.item</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="اسم الصنف"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code" required="1"/>
                                <field name="product_id" required="1"/>
                                <field name="lot_id"/>
                                <field name="meter_id"/>
                                <field name="location_id" required="1"/>
                            </group>
                            <group>
                                <field name="quantity"/>
                                <field name="min_quantity"/>
                                <field name="unit_price"/>
                                <field name="total_value" readonly="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_utility_inventory_item" model="ir.actions.act_window">
            <field name="name">أصناف المخزون</field>
            <field name="res_model">utility.inventory.item</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
