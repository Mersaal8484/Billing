<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_migration_customer_tree" model="ir.ui.view">
        <field name="name">utility.migration.customer.tree</field>
        <field name="model">utility.migration.customer</field>
        <field name="arch" type="xml">
            <tree string="بيانات التهيئة" decoration-info="state=='draft'" decoration-success="state=='imported'" decoration-danger="state=='error'">
                <field name="customer_number"/>
                <field name="name"/>
                <field name="mobile"/>
                <field name="is_active"/>
                <field name="current_balance"/>
                <field name="state" widget="badge" decoration-info="state=='draft'" decoration-success="state=='imported'" decoration-danger="state=='error'"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_migration_customer_form" model="ir.ui.view">
        <field name="name">utility.migration.customer.form</field>
        <field name="model">utility.migration.customer</field>
        <field name="arch" type="xml">
            <form string="تهيئة العميل">
                <header>
                    <button name="action_map_codes" string="مطابقة الترميز" type="object" class="btn-secondary" states="draft,error"/>
                    <button name="action_import_data" string="رفع البيانات" type="object" class="oe_highlight" states="draft,error"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,imported,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="اسم المشترك..."/></h1>
                    </div>
                    <group>
                        <group string="البيانات الأساسية">
                            <field name="customer_number"/>
                            <field name="mobile"/>
                            <field name="national_id"/>
                            <field name="legacy_category"/>
                            <field name="category_id" attrs="{'readonly': True}"/>
                            <field name="legacy_subscriber_type"/>
                            <field name="subscriber_type_id" attrs="{'readonly': True}"/>
                            <field name="is_active"/>
                            <field name="legacy_contract" attrs="{'invisible': [('is_active', '=', False)]}"/>
                            <field name="contract_template_id" attrs="{'invisible': [('is_active', '=', False)], 'readonly': True}"/>
                        </group>
                        <group string="الموقع والعداد">
                            <field name="legacy_region"/>
                            <field name="region_id" attrs="{'readonly': True}"/>
                            <field name="legacy_area"/>
                            <field name="area_id" attrs="{'readonly': True}"/>
                            <field name="meter_number" attrs="{'invisible': [('is_active', '=', False)]}"/>
                            <field name="last_reading" attrs="{'invisible': [('is_active', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="الأرصدة">
                        <group>
                            <field name="current_balance"/>
                            <field name="previous_balance"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="رسالة الخطأ" attrs="{'invisible': [('state', '!=', 'error')]}">
                            <field name="error_message" style="color: red;"/>
                        </page>
                        <page string="الارتباطات المنشأة" attrs="{'invisible': [('state', '!=', 'imported')]}">
                            <group>
                                <field name="created_partner_id"/>
                                <field name="created_customer_id"/>
                                <field name="created_meter_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_utility_migration_customer_search" model="ir.ui.view">
        <field name="name">utility.migration.customer.search</field>
        <field name="model">utility.migration.customer</field>
        <field name="arch" type="xml">
            <search string="بحث التهيئة">
                <field name="customer_number"/>
                <field name="name"/>
                <field name="mobile"/>
                <field name="national_id"/>
                <filter string="العملاء الفعالين" name="filter_active" domain="[('is_active', '=', True)]"/>
                <filter string="العملاء غير الفعالين" name="filter_inactive" domain="[('is_active', '=', False)]"/>
                <group expand="0" string="تجميع حسب...">
                    <filter string="الحالة" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="المنطقة" name="group_by_region" context="{'group_by': 'region_id'}"/>
                    <filter string="هل فعال؟" name="group_by_active" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_migration_customer" model="ir.actions.act_window">
        <field name="name">تهيئة العملاء</field>
        <field name="res_model">utility.migration.customer</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Create a top level menu for Migration in Utility -->
    <menuitem id="menu_utility_migration_root" name="التهيئة والرفع" parent="utility_core.menu_utility_root" sequence="100"/>
    <menuitem id="menu_utility_migration_customer" name="عملاء النظام القديم" parent="menu_utility_migration_root" action="action_utility_migration_customer" sequence="10"/>

</odoo>
