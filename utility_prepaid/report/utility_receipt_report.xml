<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_utility_receipt_document">
    <t t-name="utility_prepaid.report_utility_receipt_document">
      <div class="page">
        <div class="oe_structure"/>
        <h2>Utility Prepaid Receipt</h2>
        <table class="table table-borderless" style="width:100%">
          <tr>
            <td><strong>Company:</strong></td>
            <td><span t-field="docs[0].company_id.name"/></td>
          </tr>
          <tr>
            <td><strong>Receipt No:</strong></td>
            <td><span t-field="docs[0].receipt_number"/></td>
          </tr>
          <tr>
            <td><strong>Date:</strong></td>
            <td><span t-field="docs[0].date"/></td>
          </tr>
        </table>
        <hr/>
        <h3>Customer Information</h3>
        <table class="table table-borderless" style="width:100%">
          <tr>
            <td><strong>Customer:</strong></td>
            <td><span t-field="docs[0].customer_id.name"/></td>
          </tr>
          <tr>
            <td><strong>Account:</strong></td>
            <td><span t-field="docs[0].account_id.name"/></td>
          </tr>
          <tr>
            <td><strong>Meter:</strong></td>
            <td><span t-field="docs[0].meter_id.name"/></td>
          </tr>
        </table>
        <hr/>
        <h3>Purchase Details</h3>
        <table class="table table-borderless" style="width:100%">
          <tr>
            <td><strong>Amount Paid:</strong></td>
            <td><span t-field="docs[0].amount_paid" t-options='{"widget": "monetary", "display_currency": "docs[0].currency_id"}'/></td>
          </tr>
          <tr>
            <td><strong>kWh Purchased:</strong></td>
            <td><span t-field="docs[0].kwh_purchased"/></td>
          </tr>
          <tr>
            <td><strong>Unit Price:</strong></td>
            <td><span t-field="docs[0].unit_price"/></td>
          </tr>
          <tr>
            <td><strong>Token:</strong></td>
            <td><span t-field="docs[0].token_id.token_number"/></td>
          </tr>
          <tr>
            <td><strong>Payment Method:</strong></td>
            <td><span t-field="docs[0].payment_method"/></td>
          </tr>
        </table>
        <hr/>
        <p><strong>Balance Before:</strong> <span t-field="docs[0].balance_before" t-options='{"widget": "monetary", "display_currency": "docs[0].currency_id"}'/></p>
        <p><strong>Balance After:</strong> <span t-field="docs[0].balance_after" t-options='{"widget": "monetary", "display_currency": "docs[0].currency_id"}'/></p>
        <br/>
        <p>Thank you for your payment!</p>
        <div class="oe_structure"/>
      </div>
    </t>
  </template>
</odoo>
