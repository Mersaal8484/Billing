<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_utility_prepaid_user" model="res.groups">
            <field name="name">مستخدم دفع مسبق</field>
            <field name="category_id" ref="utility_core.module_category_utility_erp"/>
            <field name="implied_ids" eval="[(4, ref('utility_core.group_utility_readonly'))]"/>
        </record>

        <record id="group_utility_prepaid_cashier" model="res.groups">
            <field name="name">كاشير دفع مسبق</field>
            <field name="category_id" ref="utility_core.module_category_utility_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_utility_prepaid_user'))]"/>
        </record>

        <record id="group_utility_prepaid_supervisor" model="res.groups">
            <field name="name">مشرف دفع مسبق</field>
            <field name="category_id" ref="utility_core.module_category_utility_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_utility_prepaid_cashier'))]"/>
        </record>

        <record id="group_utility_prepaid_officer" model="res.groups">
            <field name="name">موظف دفع مسبق</field>
            <field name="category_id" ref="utility_core.module_category_utility_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_utility_prepaid_supervisor'))]"/>
        </record>

        <record id="group_utility_sts_operator" model="res.groups">
            <field name="name">مشغل STS</field>
            <field name="category_id" ref="utility_core.module_category_utility_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_utility_prepaid_user'))]"/>
        </record>

        <record id="group_utility_reversal_approver" model="res.groups">
            <field name="name">معتمد العكس</field>
            <field name="category_id" ref="utility_core.module_category_utility_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_utility_prepaid_supervisor'))]"/>
        </record>

        <record id="group_utility_adjustment_approver" model="res.groups">
            <field name="name">معتمد التسويات</field>
            <field name="category_id" ref="utility_core.module_category_utility_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_utility_prepaid_supervisor'))]"/>
        </record>

        <record id="group_utility_finance_reviewer" model="res.groups">
            <field name="name">مراجع مالي</field>
            <field name="category_id" ref="utility_core.module_category_utility_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_utility_prepaid_officer'))]"/>
        </record>

        <record id="group_utility_prepaid_manager" model="res.groups">
            <field name="name">مدير دفع مسبق</field>
            <field name="category_id" ref="utility_core.module_category_utility_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_utility_reversal_approver')), (4, ref('group_utility_adjustment_approver')), (4, ref('group_utility_finance_reviewer'))]"/>
        </record>

        <record id="group_utility_prepaid_auditor" model="res.groups">
            <field name="name">مدقق دفع مسبق</field>
            <field name="category_id" ref="utility_core.module_category_utility_erp"/>
            <field name="implied_ids" eval="[(4, ref('utility_core.group_utility_auditor'))]"/>
        </record>

        <record id="group_utility_prepaid_admin" model="res.groups">
            <field name="name">مدير نظام دفع مسبق</field>
            <field name="category_id" ref="utility_core.module_category_utility_erp"/>
            <field name="implied_ids" eval="[(4, ref('group_utility_prepaid_manager')), (4, ref('group_utility_prepaid_auditor')), (4, ref('utility_core.group_utility_admin'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="rule_prepaid_multi_company" model="ir.rule">
            <field name="name">Prepaid Multi-Company Rule</field>
            <field name="model_id" ref="model_utility_vending_request"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_token_multi_company" model="ir.rule">
            <field name="name">Token Multi-Company Rule</field>
            <field name="model_id" ref="model_utility_token"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_cashier_shift_company" model="ir.rule">
            <field name="name">Cashier Shift Multi-Company Rule</field>
            <field name="model_id" ref="model_utility_cashier_shift"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_reversal_company" model="ir.rule">
            <field name="name">Reversal Multi-Company Rule</field>
            <field name="model_id" ref="model_utility_vending_reversal"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_cashier_shift_user" model="ir.rule">
            <field name="name">Cashier Shift User Access</field>
            <field name="model_id" ref="model_utility_cashier_shift"/>
            <field name="domain_force">[('cashier_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_utility_prepaid_cashier'))]"/>
        </record>

        <record id="rule_cashier_shift_supervisor" model="ir.rule">
            <field name="name">Cashier Shift Supervisor Access</field>
            <field name="model_id" ref="model_utility_cashier_shift"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_utility_prepaid_supervisor'))]"/>
        </record>

        <record id="rule_reversal_cashier" model="ir.rule">
            <field name="name">Reversal Cashier Create Only</field>
            <field name="model_id" ref="model_utility_vending_reversal"/>
            <field name="domain_force">[('operator_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_utility_prepaid_cashier'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
