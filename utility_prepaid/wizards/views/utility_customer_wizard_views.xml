<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_customer_wizard_prepaid" model="ir.ui.view">
        <field name="name">utility.customer.wizard.prepaid</field>
        <field name="model">utility.customer.wizard</field>
        <field name="inherit_id" ref="utility_core.view_utility_customer_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='operational_number']" position="after">
                <field name="sts_key_revision" attrs="{'invisible': [('payment_type', '!=', 'prepaid')]}"/>
                <field name="communication_type" attrs="{'invisible': [('payment_type', '!=', 'postpaid')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
