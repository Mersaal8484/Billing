<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="utility_prepaid.PrepaidReceiptExtension" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[last()]" position="inside">
            <t t-if="env.pos.config.module_pos_restaurant or true">
                <div class="prepaid-receipt-section border-top pt-2 mt-2" t-if="order.is_prepaid_vending">
                    <h4 class="text-center">إيصال شحن كهرباء</h4>
                    <div class="prepaid-info">
                        <div>الحساب: <t t-esc="order.utility_account_id?.customer_number || ''"/></div>
                        <div>العداد: <t t-esc="order.utility_meter_id?.meter_number || ''"/></div>
                        <div>kWh: <t t-esc="order.vending_kwh || 0"/></div>
                        <t t-if="order.token_id?.token_number">
                            <div class="token-number font-monospace fs-5 text-center mt-2">
                                <t t-esc="order.token_id.token_number"/>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
