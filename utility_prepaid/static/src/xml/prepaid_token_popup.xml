<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="utility_prepaid.PrepaidTokenPopup" owl="1">
        <div role="dialog" class="modal-dialog modal-dialog-centered prepaid-token-popup">
            <div class="popup popup-text">
                <header class="title d-flex justify-content-between align-items-center">
                    <span><t t-esc="props.title" /></span>
                    <span class="badge bg-primary step-badge">
                        الخطوة <t t-esc="state.step" /> من 4
                    </span>
                </header>

                <main class="body">
                    <t t-if="state.error">
                        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                            <i class="fa fa-exclamation-triangle me-1"/>
                            <t t-esc="state.error" />
                            <button type="button" class="btn-close" t-on-click="() => state.error = null" aria-label="Close"/>
                        </div>
                    </t>

                    <t t-if="state.calculating">
                        <div class="loading-overlay d-flex flex-column align-items-center justify-content-center py-5">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">جاري الحساب...</span>
                            </div>
                            <span class="text-muted">جاري حساب عرض السعر...</span>
                        </div>
                    </t>

                    <t t-if="!state.calculating">
                        <t t-if="state.step === 1">
                            <div class="search-section">
                                <label class="form-label fw-bold mb-2">
                                    <i class="fa fa-search me-1"/>
                                    البحث عن المشترك
                                </label>
                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class="fa fa-user"/></span>
                                    <input type="text"
                                           class="form-control"
                                           t-att-value="state.searchQuery"
                                           t-on-input="onSearchInput"
                                           placeholder="ابحث بالاسم، رقم الحساب، رقم العداد، أو الجوال..."
                                           autocomplete="off"/>
                                    <t t-if="state.searching">
                                        <span class="input-group-text">
                                            <div class="spinner-border spinner-border-sm" role="status"/>
                                        </span>
                                    </t>
                                </div>

                                <div class="search-results list-group" t-if="state.searchResults.length > 0">
                                    <t t-foreach="state.searchResults" t-as="account" t-key="account.id">
                                        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                t-on-click="() => this.selectAccountFromSearch(account)">
                                            <div class="account-info">
                                                <div class="fw-bold">
                                                    <t t-esc="account.partner_id ? account.partner_id[1] : 'بدون اسم'" />
                                                </div>
                                                <small class="text-muted">
                                                    رقم الحساب: <t t-esc="account.customer_number" />
                                                </small>
                                            </div>
                                            <span class="badge bg-success">
                                                <t t-esc="account.meter_id ? account.meter_id[1] : 'بدون عداد'" />
                                            </span>
                                        </button>
                                    </t>
                                </div>

                                <t t-if="state.searchQuery.length >= 2 and !state.searching and state.searchResults.length === 0">
                                    <div class="text-center text-muted py-4">
                                        <i class="fa fa-info-circle fa-2x mb-2"/>
                                        <p>لم يتم العثور على نتائج</p>
                                    </div>
                                </t>

                                <t t-if="state.searchQuery.length < 2">
                                    <div class="text-center text-muted py-3">
                                        <small>اكتب حرفين على الأقل للبحث</small>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <t t-if="state.step === 2">
                            <div class="account-meter-section">
                                <div class="selected-account mb-3 p-3 bg-light rounded">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1 fw-bold">
                                                <t t-esc="state.selectedAccount.partner_id ? state.selectedAccount.partner_id[1] : ''" />
                                            </h6>
                                            <small class="text-muted">
                                                رقم الحساب: <t t-esc="state.selectedAccount.customer_number" />
                                            </small>
                                        </div>
                                        <button class="btn btn-sm btn-outline-secondary" t-on-click="goBack">
                                            <i class="fa fa-arrow-left"/>
                                        </button>
                                    </div>
                                </div>

                                <label class="form-label fw-bold mb-2">
                                    <i class="fa fa-tachometer me-1"/>
                                    اختيار العداد
                                </label>

                                <t t-if="state.meters.length === 1">
                                    <div class="selected-meter p-3 bg-success bg-opacity-10 rounded border border-success">
                                        <div class="d-flex align-items-center">
                                            <i class="fa fa-check-circle text-success fa-lg me-2"/>
                                            <div>
                                                <div class="fw-bold">
                                                    <t t-esc="state.meters[0].meter_number" />
                                                </div>
                                                <small class="text-muted">تم اختياره تلقائياً</small>
                                            </div>
                                        </div>
                                    </div>
                                </t>

                                <t t-else="">
                                    <div class="meters-list list-group">
                                        <t t-foreach="state.meters" t-as="meter" t-key="meter.id">
                                            <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                    t-att-class="{ 'active': state.selectedMeter and state.selectedMeter.id === meter.id }"
                                                    t-on-click="() => this.selectMeter(meter)">
                                                <span class="fw-bold">
                                                    <t t-esc="meter.meter_number" />
                                                </span>
                                                <t t-if="state.selectedMeter and state.selectedMeter.id === meter.id">
                                                    <i class="fa fa-check-circle text-success"/>
                                                </t>
                                            </button>
                                        </t>
                                    </div>
                                </t>

                                <t t-if="state.meters.length === 0">
                                    <div class="text-center text-muted py-4">
                                        <i class="fa fa-exclamation-triangle fa-2x mb-2"/>
                                        <p>لا توجد عدادات مسبقة الدفع لهذا الحساب</p>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <t t-if="state.step === 3">
                            <div class="amount-section">
                                <div class="summary-card mb-3 p-3 bg-light rounded">
                                    <div class="row">
                                        <div class="col-6">
                                            <small class="text-muted">الحساب</small>
                                            <div class="fw-bold">
                                                <t t-esc="state.selectedAccount.customer_number" />
                                            </div>
                                        </div>
                                        <div class="col-6 text-end">
                                            <small class="text-muted">العداد</small>
                                            <div class="fw-bold">
                                                <t t-esc="state.selectedMeter.meter_number" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <label class="form-label fw-bold mb-2">
                                    <i class="fa fa-money me-1"/>
                                    مبلغ الشحن (ريال)
                                </label>

                                <div class="input-group mb-3">
                                    <span class="input-group-text fw-bold">ر.س</span>
                                    <input type="number"
                                           class="form-control form-control-lg"
                                           t-att-value="state.amount"
                                           t-on-input="onAmountInput"
                                           placeholder="أدخل المبلغ"
                                           min="1"
                                           step="1"
                                           autofocus="autofocus"/>
                                </div>

                                <div class="numpad-grid mb-3">
                                    <button class="btn btn-outline-secondary btn-numpad" t-on-click="(ev) => this.onAmountNumpad({detail: {value: '1'}})">1</button>
                                    <button class="btn btn-outline-secondary btn-numpad" t-on-click="(ev) => this.onAmountNumpad({detail: {value: '2'}})">2</button>
                                    <button class="btn btn-outline-secondary btn-numpad" t-on-click="(ev) => this.onAmountNumpad({detail: {value: '3'}})">3</button>
                                    <button class="btn btn-outline-secondary btn-numpad" t-on-click="(ev) => this.onAmountNumpad({detail: {value: '4'}})">4</button>
                                    <button class="btn btn-outline-secondary btn-numpad" t-on-click="(ev) => this.onAmountNumpad({detail: {value: '5'}})">5</button>
                                    <button class="btn btn-outline-secondary btn-numpad" t-on-click="(ev) => this.onAmountNumpad({detail: {value: '6'}})">6</button>
                                    <button class="btn btn-outline-secondary btn-numpad" t-on-click="(ev) => this.onAmountNumpad({detail: {value: '7'}})">7</button>
                                    <button class="btn btn-outline-secondary btn-numpad" t-on-click="(ev) => this.onAmountNumpad({detail: {value: '8'}})">8</button>
                                    <button class="btn btn-outline-secondary btn-numpad" t-on-click="(ev) => this.onAmountNumpad({detail: {value: '9'}})">9</button>
                                    <button class="btn btn-outline-secondary btn-numpad" t-on-click="(ev) => this.onAmountNumpad({detail: {value: '00'}})">00</button>
                                    <button class="btn btn-outline-secondary btn-numpad" t-on-click="(ev) => this.onAmountNumpad({detail: {value: '0'}})">0</button>
                                    <button class="btn btn-outline-danger btn-numpad" t-on-click="() => state.amount = ''">
                                        <i class="fa fa-backspace"/>
                                    </button>
                                </div>

                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary flex-grow-1" t-on-click="goBack">
                                        <i class="fa fa-arrow-left me-1"/>
                                        رجوع
                                    </button>
                                    <button class="btn btn-primary flex-grow-2"
                                            t-on-click="calculateQuote"
                                            t-att-disabled="!state.amount or state.amount <= 0">
                                        <i class="fa fa-calculator me-1"/>
                                        حساب عرض السعر
                                    </button>
                                </div>
                            </div>
                        </t>

                        <t t-if="state.step === 4 and state.quote">
                            <div class="quote-section">
                                <div class="quote-header mb-3 p-3 bg-success bg-opacity-10 rounded border border-success">
                                    <div class="text-center">
                                        <i class="fa fa-check-circle text-success fa-2x mb-2"/>
                                        <h5 class="mb-1 text-success">عرض السعر</h5>
                                        <small class="text-muted">تم حساب الشحن بنجاح</small>
                                    </div>
                                </div>

                                <div class="quote-breakdown">
                                    <table class="table table-sm table-borderless mb-2">
                                        <tbody>
                                            <tr>
                                                <td>رقم الحساب</td>
                                                <td class="text-end fw-bold">
                                                    <t t-esc="state.selectedAccount.customer_number" />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>رقم العداد</td>
                                                <td class="text-end fw-bold">
                                                    <t t-esc="state.selectedMeter.meter_number" />
                                                </td>
                                            </tr>
                                            <tr class="table-divider"><td colspan="2"><hr class="my-1"/></td></tr>
                                            <tr>
                                                <td>المبلغ الإجمالي</td>
                                                <td class="text-end fw-bold">
                                                    <t t-esc="this.formatNumber(state.quote.gross_amount)"/> ريال
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>قيمة الطاقة</td>
                                                <td class="text-end text-success">
                                                    <t t-esc="this.formatNumber(state.quote.energy_amount)"/> ريال
                                                </td>
                                            </tr>
                                            <tr t-if="state.quote.service_charge > 0">
                                                <td>رسوم الخدمة</td>
                                                <td class="text-end text-danger">
                                                    - <t t-esc="this.formatNumber(state.quote.service_charge)"/> ريال
                                                </td>
                                            </tr>
                                            <tr t-if="state.quote.tax_amount > 0">
                                                <td>الضريبة</td>
                                                <td class="text-end text-danger">
                                                    - <t t-esc="this.formatNumber(state.quote.tax_amount)"/> ريال
                                                </td>
                                            </tr>
                                            <tr t-if="state.quote.debt_recovery_amount > 0">
                                                <td>استقطاع الديون</td>
                                                <td class="text-end text-danger">
                                                    - <t t-esc="this.formatNumber(state.quote.debt_recovery_amount)"/> ريال
                                                </td>
                                            </tr>
                                            <tr t-if="state.quote.other_deduction_amount > 0">
                                                <td>خصومات أخرى</td>
                                                <td class="text-end text-danger">
                                                    - <t t-esc="this.formatNumber(state.quote.other_deduction_amount)"/> ريال
                                                </td>
                                            </tr>
                                            <tr class="table-divider"><td colspan="2"><hr class="my-1"/></td></tr>
                                            <tr class="table-active">
                                                <td class="fw-bold fs-5">kWh المشتراة</td>
                                                <td class="text-end fw-bold fs-5 text-primary">
                                                    <t t-esc="this.formatNumber(state.quote.kwh_purchased, 3)"/> kWh
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn btn-outline-secondary flex-grow-1" t-on-click="goBack">
                                        <i class="fa fa-arrow-left me-1"/>
                                        رجوع
                                    </button>
                                    <button class="btn btn-success flex-grow-2" t-on-click="confirm">
                                        <i class="fa fa-check me-1"/>
                                        تأكيد الشحن
                                    </button>
                                </div>
                            </div>
                        </t>
                    </t>
                </main>

                <footer class="footer d-flex justify-content-end">
                    <button class="button cancel" t-on-click="cancel">
                        <i class="fa fa-times me-1"/>
                        <t t-esc="props.cancelText" />
                    </button>
                </footer>
            </div>
        </div>
    </t>

</templates>
