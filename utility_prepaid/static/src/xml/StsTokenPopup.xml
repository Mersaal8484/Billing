<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="utility_prepaid.StsTokenPopup" owl="1">
        <div role="dialog" class="modal-dialog">
            <div class="popup popup-text">
                <header class="title"><t t-esc="props.title" /></header>
                <main class="body">
                    <div class="form-group row align-items-center mb-3">
                        <label class="col-sm-4 col-form-label text-start">حساب المشترك</label>
                        <div class="col-sm-8">
                            <select class="form-select w-100 p-2" t-model="state.selectedAccountId">
                                <t t-foreach="props.accounts" t-as="account" t-key="account.id">
                                    <option t-att-value="account.id">
                                        <t t-esc="account.customer_number" /> - <t t-esc="account.meter_id ? account.meter_id[1] : 'بدون عداد'" />
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                    
                    <div t-if="selectedAccount" class="mb-3 text-start">
                        <small class="text-muted">الرصيد المسبق الحالي: <t t-esc="env.pos.format_currency(selectedAccount.prepaid_balance)"/></small>
                    </div>

                    <div class="form-group row align-items-center">
                        <label class="col-sm-4 col-form-label text-start">المبلغ (شحن)</label>
                        <div class="col-sm-8">
                            <input type="number" class="form-control w-100 p-2" t-model="state.amount" min="1" step="1" />
                        </div>
                    </div>
                </main>
                <footer class="footer">
                    <div class="button confirm highlight" t-on-click="confirm">
                        <t t-esc="props.confirmText" />
                    </div>
                    <div class="button cancel" t-on-click="cancel">
                        <t t-esc="props.cancelText" />
                    </div>
                </footer>
            </div>
        </div>
    </t>
</templates>
