<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="utility_prepaid.PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('partner-line-balance')]" position="replace">
            <div class="partner-line-balance">
                <!-- Postpaid Balance (Red) -->
                <t t-if="props.partner.utility_postpaid_balance">
                    <span class="text-danger fw-bold" style="margin-right: 10px;">
                        آجل: <t t-esc="env.pos.format_currency(props.partner.utility_postpaid_balance)"/>
                    </span>
                </t>
                <!-- Keep original balance if any -->
                <span t-if="props.partner.balance" class="text-muted">
                    <t t-esc="env.pos.format_currency(props.partner.balance)"/>
                </span>
            </div>
        </xpath>
    </t>
</templates>
