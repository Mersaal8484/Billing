<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="utility_prepaid.PrepaidStatusPopup" owl="1">
        <div role="dialog" class="modal-dialog modal-dialog-centered prepaid-status-popup">
            <div class="popup popup-text">
                <header class="title d-flex justify-content-between align-items-center">
                    <span><t t-esc="props.title" /></span>
                    <t t-if="state.token and state.token.status === 'pending'">
                        <span class="badge bg-warning">
                            <i class="fa fa-clock me-1"/>
                            تحديث تلقائي
                        </span>
                    </t>
                </header>

                <main class="body">
                    <t t-if="state.loading">
                        <div class="loading-overlay d-flex flex-column align-items-center justify-content-center py-5">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">جاري التحميل...</span>
                            </div>
                            <span class="text-muted">جاري جلب حالة التوكن...</span>
                        </div>
                    </t>

                    <t t-if="state.error and !state.loading">
                        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                            <i class="fa fa-exclamation-triangle me-1"/>
                            <t t-esc="state.error" />
                            <button type="button" class="btn-close" t-on-click="() => state.error = null" aria-label="Close"/>
                        </div>
                    </t>

                    <t t-if="!state.loading and state.token">
                        <div class="token-status-container">
                            <div class="status-header text-center mb-4" t-att-class="statusClass">
                                <t t-if="state.token.status === 'success'">
                                    <i class="fa fa-check-circle fa-4x text-success mb-3"/>
                                </t>
                                <t t-elif="state.token.status === 'failed'">
                                    <i class="fa fa-times-circle fa-4x text-danger mb-3"/>
                                </t>
                                <t t-elif="state.token.status === 'pending'">
                                    <i class="fa fa-hourglass-half fa-4x text-warning mb-3"/>
                                </t>
                                <t t-else="">
                                    <i class="fa fa-ban fa-4x text-muted mb-3"/>
                                </t>
                                <h4 class="mb-1" t-esc="statusLabel"/>
                                <small class="text-muted">
                                    آخر فحص: <t t-if="state.lastChecked"><t t-esc="state.lastChecked.toLocaleTimeString('ar-SA')"/></t>
                                </small>
                            </div>

                            <t t-if="state.token.status === 'success'">
                                <div class="token-number-card mb-4 p-4 bg-success bg-opacity-10 rounded border border-success text-center">
                                    <label class="text-muted mb-2 d-block">رقم رمز الشحن (STS)</label>
                                    <div class="token-number-display font-monospace fs-2 fw-bold text-success letter-spacing-2">
                                        <t t-esc="formattedTokenNumber" />
                                    </div>
                                </div>
                            </t>

                            <div class="token-details mb-3">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="detail-card p-2 bg-light rounded text-center">
                                            <small class="text-muted d-block">kWh</small>
                                            <span class="fw-bold fs-5" t-esc="displayKwh"/>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="detail-card p-2 bg-light rounded text-center">
                                            <small class="text-muted d-block">المبلغ</small>
                                            <span class="fw-bold fs-5" t-esc="displayAmount"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <t t-if="state.token.status === 'failed' and state.token.response_message">
                                <div class="alert alert-warning mb-3" role="alert">
                                    <i class="fa fa-exclamation-triangle me-1"/>
                                    <strong>رسالة الخطأ:</strong>
                                    <p class="mb-0 mt-1" t-esc="state.token.response_message"/>
                                </div>
                            </t>

                            <div class="action-buttons d-grid gap-2">
                                <t t-if="state.token.status === 'success'">
                                    <button class="btn btn-success" t-on-click="printReceipt">
                                        <i class="fa fa-print me-1"/>
                                        طباعة الإيصال
                                    </button>
                                    <button class="btn btn-outline-primary" t-on-click="resendSMS">
                                        <i class="fa fa-mobile me-1"/>
                                        إعادة إرسال SMS
                                    </button>
                                </t>
                                <t t-if="state.token.status === 'pending'">
                                    <button class="btn btn-warning" t-on-click="refreshStatus">
                                        <i class="fa fa-refresh me-1"/>
                                        تحديث الحالة
                                    </button>
                                    <button class="btn btn-outline-secondary" t-on-click="retryToken">
                                        <i class="fa fa-repeat me-1"/>
                                        إعادة محاولة التوليد
                                    </button>
                                </t>
                                <t t-if="state.token.status === 'failed'">
                                    <button class="btn btn-outline-secondary" t-on-click="retryToken">
                                        <i class="fa fa-repeat me-1"/>
                                        إعادة محاولة التوليد
                                    </button>
                                </t>
                            </div>
                        </div>
                    </t>

                    <t t-if="!state.loading and !state.token and !state.error">
                        <div class="text-center text-muted py-5">
                            <i class="fa fa-search fa-3x mb-3"/>
                            <p>لم يتم العثور على توكن لهذا الطلب</p>
                            <button class="btn btn-outline-primary mt-2" t-on-click="refreshStatus">
                                <i class="fa fa-refresh me-1"/>
                                تحديث
                            </button>
                        </div>
                    </t>
                </main>

                <footer class="footer d-flex justify-content-end">
                    <button class="button confirm highlight" t-on-click="cancel">
                        <i class="fa fa-times me-1"/>
                        <t t-esc="props.closeText" />
                    </button>
                </footer>
            </div>
        </div>
    </t>

</templates>
