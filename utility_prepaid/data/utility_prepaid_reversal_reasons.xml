<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="reversal_reason_customer_request" model="utility.reversal.reason">
            <field name="name">طلب العميل</field>
            <field name="code">CUST_REQ</field>
            <field name="category">customer</field>
            <field name="requires_approval" eval="True"/>
            <field name="description">طلب العميل إلغاء الشحنة</field>
        </record>

        <record id="reversal_reason_wrong_meter" model="utility.reversal.reason">
            <field name="name">عداد خاطئ</field>
            <field name="code">WRONG_METER</field>
            <field name="category">technical</field>
            <field name="requires_approval" eval="True"/>
            <field name="description">تم الشحن على عداد خاطئ</field>
        </record>

        <record id="reversal_reason_wrong_amount" model="utility.reversal.reason">
            <field name="name">مبلغ خاطئ</field>
            <field name="code">WRONG_AMT</field>
            <field name="category">billing</field>
            <field name="requires_approval" eval="True"/>
            <field name="description">تم شحن مبلغ خاطئ</field>
        </record>

        <record id="reversal_reason_system_error" model="utility.reversal.reason">
            <field name="name">خطأ في النظام</field>
            <field name="code">SYS_ERR</field>
            <field name="category">system</field>
            <field name="requires_approval" eval="True"/>
            <field name="description">خطأ تقني في النظام</field>
        </record>

        <record id="reversal_reason_duplicate" model="utility.reversal.reason">
            <field name="name">عملية مكررة</field>
            <field name="code">DUPLICATE</field>
            <field name="category">system</field>
            <field name="requires_approval" eval="True"/>
            <field name="description">تم تنفيذ العملية مرتين بالخطأ</field>
        </record>

        <record id="reversal_reason_token_not_accepted" model="utility.reversal.reason">
            <field name="name">التوكن لم يُقبل في العداد</field>
            <field name="code">TKN_REJECT</field>
            <field name="category">technical</field>
            <field name="requires_approval" eval="True"/>
            <field name="description">لم يتم قبول التوكن في العداد</field>
        </record>

        <record id="reversal_reason_other" model="utility.reversal.reason">
            <field name="name">أخرى</field>
            <field name="code">OTHER</field>
            <field name="category">other</field>
            <field name="requires_approval" eval="True"/>
        </record>
    </data>
</odoo>
