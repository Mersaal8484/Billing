<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="channel_pos" model="utility.vending.channel">
            <field name="name">نقاط البيع (POS)</field>
            <field name="code">POS</field>
            <field name="channel_type">pos</field>
            <field name="sequence">10</field>
            <field name="is_default" eval="True"/>
        </record>

        <record id="channel_portal" model="utility.vending.channel">
            <field name="name">بوابة العميل</field>
            <field name="code">PORTAL</field>
            <field name="channel_type">portal</field>
            <field name="sequence">20</field>
            <field name="allow_self_service" eval="True"/>
        </record>

        <record id="channel_api" model="utility.vending.channel">
            <field name="name">واجهة API</field>
            <field name="code">API</field>
            <field name="channel_type">api</field>
            <field name="sequence">30</field>
        </record>

        <record id="channel_mobile" model="utility.vending.channel">
            <field name="name">تطبيق الهاتف</field>
            <field name="code">MOBILE</field>
            <field name="channel_type">mobile_app</field>
            <field name="sequence">40</field>
            <field name="allow_self_service" eval="True"/>
        </record>

        <record id="channel_agent" model="utility.vending.channel">
            <field name="name">وكيل بيع</field>
            <field name="code">AGENT</field>
            <field name="channel_type">agent</field>
            <field name="sequence">50</field>
        </record>

        <record id="channel_payment_gateway" model="utility.vending.channel">
            <field name="name">بوابة دفع إلكترونية</field>
            <field name="code">PAYGATE</field>
            <field name="channel_type">payment_gateway</field>
            <field name="sequence">60</field>
            <field name="allow_self_service" eval="True"/>
        </record>

        <record id="channel_customer_service" model="utility.vending.channel">
            <field name="name">خدمة العملاء</field>
            <field name="code">CS</field>
            <field name="channel_type">customer_service</field>
            <field name="sequence">70</field>
        </record>

        <record id="provider_simulated" model="utility.sts.provider">
            <field name="name">مزود محاكاة (اختبار)</field>
            <field name="code">SIMULATED</field>
            <field name="provider_type">simulated</field>
            <field name="sequence">1</field>
            <field name="is_default" eval="True"/>
            <field name="timeout">30</field>
            <field name="max_retries">3</field>
        </record>
    </data>
</odoo>
