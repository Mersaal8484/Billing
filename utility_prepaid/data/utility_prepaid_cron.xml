<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_retry_failed_sts" model="ir.cron">
            <field name="name">إعادة محاولة طلبات STS الفاشلة</field>
            <field name="model_id" ref="model_utility_sts_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_failed_sts()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_query_pending_sts" model="ir.cron">
            <field name="name">استعلام معاملات STS المعلقة</field>
            <field name="model_id" ref="model_utility_sts_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_query_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_reconcile_pos_vending" model="ir.cron">
            <field name="name">مطابقة POS وطلبات البيع</field>
            <field name="model_id" ref="model_utility_vending_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_reconcile_pos_vending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_send_pending_notifications" model="ir.cron">
            <field name="name">إرسال إشعارات التوكن المعلقة</field>
            <field name="model_id" ref="model_utility_token"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_pending_notifications()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_process_low_credit" model="ir.cron">
            <field name="name">معالجة تنبيهات الرصيد المنخفض</field>
            <field name="model_id" ref="model_utility_prepaid_ami_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_low_credit()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_expire_unpaid_vending" model="ir.cron">
            <field name="name">إلغاء طلبات البيع غير المدفوعة</field>
            <field name="model_id" ref="model_utility_vending_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_unpaid()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_monitor_provider_health" model="ir.cron">
            <field name="name">مراقبة صحة مزودي STS</field>
            <field name="model_id" ref="model_utility_sts_provider"/>
            <field name="state">code</field>
            <field name="code">model._cron_monitor_health()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_process_ami_events" model="ir.cron">
            <field name="name">معالجة أحداث AMI غير المعالجة</field>
            <field name="model_id" ref="model_utility_prepaid_ami_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_unprocessed()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
