<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ====== Prepaid Vending Product ====== -->
        <record id="product_prepaid_vending" model="product.product">
            <field name="name">شحن كهرباء مسبقة الدفع</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="is_prepaid_product" eval="True"/>
            <field name="default_code">PREPAID_VEND</field>
        </record>

        <!-- ====== Debt Recovery Policy ====== -->
        <record id="debt_policy_standard" model="utility.prepaid.debt.policy">
            <field name="name">سياسة استقطاع الديون القياسية</field>
            <field name="recovery_method">percentage</field>
            <field name="recovery_percentage">20.0</field>
            <field name="max_recovery_per_vending">500.0</field>
            <field name="min_energy_percentage">10.0</field>
            <field name="scope">all</field>
            <field name="debt_types">all</field>
            <field name="active" eval="True"/>
        </record>

        <!-- ====== Vending Policy ====== -->
        <record id="vending_policy_standard" model="utility.vending.policy">
            <field name="name">سياسة البيع القياسية</field>
            <field name="policy_type">standard</field>
            <field name="scope">all</field>
            <field name="sequence">10</field>
            <field name="minimum_vending_amount">5.0</field>
            <field name="maximum_vending_amount">5000.0</field>
            <field name="service_charge_fixed">1.0</field>
            <field name="service_charge_percentage">2.0</field>
            <field name="tax_percentage">5.0</field>
            <field name="enable_debt_recovery" eval="True"/>
            <field name="max_debt_recovery_percentage">20.0</field>
            <field name="min_energy_after_recovery">10.0</field>
            <field name="active" eval="True"/>
        </record>

        <!-- ====== Reversal Reasons ====== -->
        <record id="reversal_reason_token_not_used" model="utility.reversal.reason">
            <field name="name">الرمز لم يتم استخدامه</field>
            <field name="code">TOKEN_NOT_USED</field>
            <field name="requires_approval" eval="True"/>
            <field name="active" eval="True"/>
        </record>

        <record id="reversal_reason_wrong_amount" model="utility.reversal.reason">
            <field name="name">مبلغ خاطئ</field>
            <field name="code">WRONG_AMOUNT</field>
            <field name="requires_approval" eval="True"/>
            <field name="active" eval="True"/>
        </record>

        <record id="reversal_reason_wrong_meter" model="utility.reversal.reason">
            <field name="name">عداد خاطئ</field>
            <field name="code">WRONG_METER</field>
            <field name="requires_approval" eval="True"/>
            <field name="active" eval="True"/>
        </record>

        <record id="reversal_reason_system_error" model="utility.reversal.reason">
            <field name="name">خطأ في النظام</field>
            <field name="code">SYSTEM_ERROR</field>
            <field name="requires_approval" eval="False"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
