<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_utility_vending_request" model="ir.sequence">
            <field name="name">طلب بيع مسبق</field>
            <field name="code">utility.vending.request</field>
            <field name="prefix">VR/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_token" model="ir.sequence">
            <field name="name">رمز STS</field>
            <field name="code">utility.token</field>
            <field name="prefix">TK/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_transaction" model="ir.sequence">
            <field name="name">ماملة دفع مسبق</field>
            <field name="code">utility.transaction</field>
            <field name="prefix">TX/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>



        <record id="seq_utility_vending_reversal" model="ir.sequence">
            <field name="name">طلب عكس بيع مسبق</field>
            <field name="code">utility.vending.reversal</field>
            <field name="prefix">RV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_prepaid_adjustment" model="ir.sequence">
            <field name="name">تسوية دفع مسبق</field>
            <field name="code">utility.prepaid.adjustment</field>
            <field name="prefix">ADJ/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_sts_transaction" model="ir.sequence">
            <field name="name">معاملة STS</field>
            <field name="code">utility.sts.transaction</field>
            <field name="prefix">STS/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_key_change_campaign" model="ir.sequence">
            <field name="name">حملة تغيير مفتاح STS</field>
            <field name="code">utility.key.change.campaign</field>
            <field name="prefix">KC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_prepaid_ami_event" model="ir.sequence">
            <field name="name">حدث AMI دفع مسبق</field>
            <field name="code">utility.prepaid.ami.event</field>
            <field name="prefix">AMI/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_prepaid_integration_log" model="ir.sequence">
            <field name="name">سجل تكامل دفع مسبق</field>
            <field name="code">utility.prepaid.integration.log</field>
            <field name="prefix">LOG/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_debt_recovery" model="ir.sequence">
            <field name="name">استقطاع دين</field>
            <field name="code">utility.debt.recovery</field>
            <field name="prefix">DR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_utility_cashier_shift" model="ir.sequence">
            <field name="name">وردية كاشير الدفع المسبق</field>
            <field name="code">utility.cashier.shift</field>
            <field name="prefix">PPSH/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>    </data>
</odoo>
