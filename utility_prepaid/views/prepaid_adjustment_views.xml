<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prepaid_adjustment_tree" model="ir.ui.view">
        <field name="name">utility.prepaid.adjustment.tree</field>
        <field name="model">utility.prepaid.adjustment</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ('cancelled')" decoration-success="state == 'applied'" decoration-warning="state in ('draft', 'submitted', 'under_review')" decoration-info="state == 'approved'">
                <field name="reference"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="meter_id"/>
                <field name="adjustment_type" widget="badge"/>
                <field name="amount" widget="monetary"/>
                <field name="kwh_amount"/>
                <field name="state" widget="badge" decoration-success="state == 'applied'" decoration-warning="state in ('draft', 'submitted', 'under_review')" decoration-info="state == 'approved'" decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_prepaid_adjustment_form" model="ir.ui.view">
        <field name="name">utility.prepaid.adjustment.form</field>
        <field name="model">utility.prepaid.adjustment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="تقديم" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_review" string="مراجعة" type="object" attrs="{'invisible': [('state', '!=', 'submitted')]}"/>
                    <button name="action_approve" string="موافقة" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ('under_review', 'submitted'))]}"/>
                    <button name="action_apply" string="تطبيق" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'approved')]}"/>
                    <button name="action_cancel" string="إلغاء" type="object" attrs="{'invisible': [('state', '=', 'applied')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,approved,applied"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="partner_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="account_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="meter_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="adjustment_type" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="amount" widget="monetary" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="kwh_amount" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="approved_by" attrs="{'invisible': [('approved_by', '=', False)]}"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="سبب التسوية..." attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="technical_report" placeholder="التقرير الفني..." attrs="{'invisible': [('adjustment_type', 'not in', ('correction', 'meter_replacement'))]}"/>
                    <notebook>
                        <page string="معلومات محاسبية" name="accounting">
                            <group>
                                <field name="account_move_id"/>
                                <field name="token_id"/>
                            </group>
                        </page>
                        <page string="ملاحظات" name="notes">
                            <field name="notes" placeholder="ملاحظات..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_prepaid_adjustment_all" model="ir.actions.act_window">
        <field name="name">التسويات</field>
        <field name="res_model">utility.prepaid.adjustment</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
