<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_utility_customer_form_prepaid" model="ir.ui.view">
        <field name="name">utility.customer.form.prepaid</field>
        <field name="model">utility.customer</field>
        <field name="inherit_id" ref="utility_core.view_utility_customer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pos_orders" type="object"
                        class="oe_stat_button" icon="fa-shopping-cart"
                        attrs="{'invisible': [('payment_type', '!=', 'prepaid')]}">
                    <field name="pos_order_count" string="طلبات POS" widget="statinfo"/>
                </button>
                <button name="action_view_vending_requests" type="object"
                        class="oe_stat_button" icon="fa-bolt"
                        attrs="{'invisible': [('payment_type', '!=', 'prepaid')]}">
                    <field name="vending_request_count" string="طلبات الشحن" widget="statinfo"/>
                </button>
                <button name="action_view_tokens" type="object"
                        class="oe_stat_button" icon="fa-key"
                        attrs="{'invisible': [('payment_type', '!=', 'prepaid')]}">
                    <field name="token_count" string="الرموز" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='accounting_balance']" position="after">
                <field name="credit_limit"/>
                <field name="total_purchases" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1" attrs="{'invisible': [('payment_type', '!=', 'prepaid')]}"/>
                <field name="total_kwh_purchased" readonly="1" attrs="{'invisible': [('payment_type', '!=', 'prepaid')]}"/>
                <field name="last_purchase_date" readonly="1" attrs="{'invisible': [('payment_type', '!=', 'prepaid')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
