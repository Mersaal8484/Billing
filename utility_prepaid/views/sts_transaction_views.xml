<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sts_transaction_tree" model="ir.ui.view">
        <field name="name">utility.sts.transaction.tree</field>
        <field name="model">utility.sts.transaction</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'success'" decoration-danger="state == 'failed'" decoration-warning="state in ('pending', 'sent')" decoration-muted="state == 'cancelled'">
                <field name="reference"/>
                <field name="provider_id"/>
                <field name="meter_id"/>
                <field name="account_id"/>
                <field name="transaction_type" widget="badge"/>
                <field name="amount" widget="monetary"/>
                <field name="kwh"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'failed'" decoration-warning="state in ('pending', 'sent')" decoration-info="state == 'reversed'" decoration-muted="state == 'cancelled'"/>
                <field name="create_date"/>
                <field name="retry_count"/>
            </tree>
        </field>
    </record>

    <record id="view_sts_transaction_form" model="ir.ui.view">
        <field name="name">utility.sts.transaction.form</field>
        <field name="model">utility.sts.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_request" string="إرسال الطلب" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ('pending', 'failed'))]}"/>
                    <button name="action_query_status" string="استعلام الحالة" type="object" attrs="{'invisible': [('provider_reference', '=', False)]}"/>
                    <button name="action_reverse" string="عكس" type="object" attrs="{'invisible': [('state', '!=', 'success')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent,success"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="provider_id"/>
                            <field name="transaction_type"/>
                            <field name="meter_id"/>
                            <field name="account_id"/>
                        </group>
                        <group>
                            <field name="vending_request_id"/>
                            <field name="token_id"/>
                            <field name="amount" widget="monetary"/>
                            <field name="kwh"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="token_value"/>
                            <field name="token_identifier"/>
                            <field name="provider_reference"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="response_date"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="أخطاء" name="errors" attrs="{'invisible': [('error_message', '=', False)]}">
                            <group>
                                <field name="error_code"/>
                                <field name="error_message"/>
                            </group>
                        </page>
                        <page string="بيانات خام" name="raw_data" groups="base.group_no_one">
                            <field name="raw_request"/>
                            <field name="raw_response"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_sts_transaction_all" model="ir.actions.act_window">
        <field name="name">معاملات STS</field>
        <field name="res_model">utility.sts.transaction</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
