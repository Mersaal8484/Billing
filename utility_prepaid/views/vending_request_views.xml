<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vending Request Tree View -->
    <record id="view_vending_request_tree" model="ir.ui.view">
        <field name="name">utility.vending.request.tree</field>
        <field name="model">utility.vending.request</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ('cancelled')" decoration-success="state == 'completed'" decoration-warning="state in ('quoted', 'confirmed', 'paid')" decoration-danger="state == 'token_failed'">
                <field name="reference"/>
                <field name="vending_date"/>
                <field name="account_id"/>
                <field name="meter_id"/>
                <field name="gross_amount" widget="monetary"/>
                <field name="kwh_purchased"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state in ('completed', 'token_generated')" decoration-warning="state in ('quoted', 'confirmed', 'paid', 'token_pending')" decoration-danger="state in ('token_failed', 'cancelled')"/>
                <field name="channel_id"/>
                <field name="operator_id"/>
            </tree>
        </field>
    </record>

    <!-- Vending Request Form View -->
    <record id="view_vending_request_form" model="ir.ui.view">
        <field name="name">utility.vending.request.form</field>
        <field name="model">utility.vending.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_quote" string="إنشاء عرض سعر" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_confirm" string="تأكيد" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'quoted')]}"/>
                    <button name="action_mark_paid" string="تحديد كمدفوع" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_submit_to_sts" string="إرسال إلى STS" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'paid')]}"/>
                    <button name="action_complete" string="إكمال" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ('token_generated', 'paid'))]}"/>
                    <button name="action_retry_token" string="إعادة محاولة" type="object" attrs="{'invisible': [('state', 'not in', ('token_pending', 'token_failed'))]}"/>
                    <button name="action_cancel" string="إلغاء" type="object" attrs="{'invisible': [('state', 'in', ('completed', 'token_generated'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,quoted,confirmed,paid,token_generated,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tokens" type="object" class="oe_stat_button" icon="fa-key" attrs="{'invisible': [('token_ids', '=', [])]}">
                            <field name="token_ids" widget="statinfo" string="الرموز"/>
                        </button>
                        <button name="action_view_transactions" type="object" class="oe_stat_button" icon="fa-exchange" attrs="{'invisible': [('transaction_ids', '=', [])]}">
                            <field name="transaction_ids" widget="statinfo" string="المعاملات"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="account_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="meter_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="channel_id"/>
                        </group>
                        <group>
                            <field name="vending_date"/>
                            <field name="operator_id"/>
                            <field name="pos_order_id"/>
                            <field name="shift_id"/>
                            <field name="idempotency_key" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group string="المبالغ">
                        <group>
                            <field name="gross_amount" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="service_charge_amount"/>
                            <field name="tax_amount"/>
                        </group>
                        <group>
                            <field name="energy_amount"/>
                            <field name="debt_recovery_amount"/>
                            <field name="net_vending_amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="kwh_purchased"/>
                        <field name="retry_count" attrs="{'invisible': [('retry_count', '=', 0)]}"/>
                    </group>
                    <notebook>
                        <page string="بنود الشحنة" name="charge_lines">
                            <field name="charge_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="charge_type"/>
                                    <field name="description"/>
                                    <field name="amount" widget="monetary"/>
                                </tree>
                            </field>
                        </page>
                        <page string="رموز STS" name="tokens">
                            <field name="token_ids">
                                <tree>
                                    <field name="token_number"/>
                                    <field name="token_type"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="kwh"/>
                                    <field name="status" widget="badge"/>
                                    <field name="delivery_state"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="معاملات STS" name="sts_transactions">
                            <field name="sts_transaction_ids">
                                <tree>
                                    <field name="reference"/>
                                    <field name="provider_id"/>
                                    <field name="transaction_type"/>
                                    <field name="state" widget="badge"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="المعاملات المالية" name="transactions">
                            <field name="transaction_ids">
                                <tree>
                                    <field name="reference"/>
                                    <field name="transaction_type"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="date"/>
                                    <field name="operator_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ملاحظات" name="notes">
                            <field name="notes"/>
                            <field name="last_error" attrs="{'invisible': [('last_error', '=', False)]}"/>
                            <field name="tariff_snapshot" groups="base.group_no_one"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vending Request Search View -->
    <record id="view_vending_request_search" model="ir.ui.view">
        <field name="name">utility.vending.request.search</field>
        <field name="model">utility.vending.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="account_id"/>
                <field name="meter_id"/>
                <field name="partner_id"/>
                <field name="pos_order_id"/>
                <filter name="draft" string="مسودة" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="مؤكد" domain="[('state', '=', 'confirmed')]"/>
                <filter name="paid" string="مدفوع" domain="[('state', '=', 'paid')]"/>
                <filter name="completed" string="مكتمل" domain="[('state', '=', 'completed')]"/>
                <filter name="failed" string="فاشل" domain="[('state', '=', 'token_failed')]"/>
                <filter name="today" string="اليوم" domain="[('vending_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                    <filter name="group_channel" string="القناة" context="{'group_by': 'channel_id'}"/>
                    <filter name="group_operator" string="المشغل" context="{'group_by': 'operator_id'}"/>
                    <filter name="group_date" string="التاريخ" context="{'group_by': 'vending_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vending Request Actions -->
    <record id="action_vending_request_all" model="ir.actions.act_window">
        <field name="name">طلبات البيع</field>
        <field name="res_model">utility.vending.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_vending_request_search"/>
    </record>

    <record id="action_vending_request_pending" model="ir.actions.act_window">
        <field name="name">طلبات بيع معلقة</field>
        <field name="res_model">utility.vending.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', 'in', ('draft', 'quoted', 'confirmed', 'paid', 'token_pending'))]</field>
    </record>

    <record id="action_vending_request_failed" model="ir.actions.act_window">
        <field name="name">طلبات بيع فاشلة</field>
        <field name="res_model">utility.vending.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'token_failed')]</field>
    </record>

    <record id="action_vending_request_completed" model="ir.actions.act_window">
        <field name="name">طلبات بيع مكتملة</field>
        <field name="res_model">utility.vending.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'completed')]</field>
    </record>

    <!-- Vending Channel Views & Actions -->
    <record id="view_vending_channel_tree" model="ir.ui.view">
        <field name="name">utility.vending.channel.tree</field>
        <field name="model">utility.vending.channel</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="channel_type" widget="badge"/>
                <field name="is_default"/>
                <field name="active"/>
                <field name="sequence"/>
            </tree>
        </field>
    </record>

    <record id="view_vending_channel_form" model="ir.ui.view">
        <field name="name">utility.vending.channel.form</field>
        <field name="model">utility.vending.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="channel_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="is_default"/>
                            <field name="allow_self_service"/>
                            <field name="require_approval"/>
                        </group>
                    </group>
                    <field name="description" placeholder="وصف القناة..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vending_channel_all" model="ir.actions.act_window">
        <field name="name">قنوات البيع</field>
        <field name="res_model">utility.vending.channel</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Vending Policy Views & Actions -->
    <record id="view_vending_policy_tree" model="ir.ui.view">
        <field name="name">utility.vending.policy.tree</field>
        <field name="model">utility.vending.policy</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="policy_type" widget="badge"/>
                <field name="scope"/>
                <field name="minimum_vending_amount" widget="monetary"/>
                <field name="maximum_vending_amount" widget="monetary"/>
                <field name="enable_debt_recovery"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_vending_policy_form" model="ir.ui.view">
        <field name="name">utility.vending.policy.form</field>
        <field name="model">utility.vending.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="policy_type"/>
                            <field name="scope"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="حدود البيع">
                        <group>
                            <field name="minimum_vending_amount"/>
                            <field name="maximum_vending_amount"/>
                        </group>
                    </group>
                    <group string="الرسوم">
                        <group>
                            <field name="service_charge_fixed"/>
                            <field name="service_charge_percentage"/>
                        </group>
                        <group>
                            <field name="tax_percentage"/>
                        </group>
                    </group>
                    <group string="استقطاع الديون">
                        <group>
                            <field name="enable_debt_recovery"/>
                            <field name="max_debt_recovery_percentage"/>
                        </group>
                        <group>
                            <field name="min_energy_after_recovery"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="النطاق" name="scope">
                            <group>
                                <field name="category_ids" widget="many2many_tags" attrs="{'invisible': [('scope', '!=', 'category')]}"/>
                                <field name="subscriber_ids" widget="many2many_tags" attrs="{'invisible': [('scope', '!=', 'subscriber')]}"/>
                                <field name="region_ids" widget="many2many_tags" attrs="{'invisible': [('scope', 'not in', ('region', 'route'))]}"/>
                                <field name="route_ids" widget="many2many_tags" attrs="{'invisible': [('scope', '!=', 'route')]}"/>
                                <field name="substation_ids" widget="many2many_tags" attrs="{'invisible': [('scope', '!=', 'transformer')]}"/>
                                <field name="transformer_ids" widget="many2many_tags" attrs="{'invisible': [('scope', '!=', 'transformer')]}"/>
                                <field name="contract_template_ids" widget="many2many_tags" attrs="{'invisible': [('scope', '!=', 'contract')]}"/>
                            </group>
                        </page>
                        <page string="الوصف" name="description">
                            <field name="description" placeholder="وصف السياسة..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vending_policy_all" model="ir.actions.act_window">
        <field name="name">سياسات البيع</field>
        <field name="res_model">utility.vending.policy</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Key Change Campaign Views & Actions -->
    <record id="view_key_change_campaign_tree" model="ir.ui.view">
        <field name="name">utility.key.change.campaign.tree</field>
        <field name="model">utility.key.change.campaign</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ('cancelled')" decoration-success="state == 'completed'" decoration-warning="state in ('draft', 'planned')" decoration-info="state == 'in_progress'">
                <field name="name"/>
                <field name="reference"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="provider_id"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-warning="state in ('draft', 'planned')" decoration-info="state == 'in_progress'" decoration-muted="state == 'cancelled'"/>
                <field name="meter_count"/>
                <field name="total_tokens_generated"/>
                <field name="total_tokens_failed"/>
            </tree>
        </field>
    </record>

    <record id="view_key_change_campaign_form" model="ir.ui.view">
        <field name="name">utility.key.change.campaign.form</field>
        <field name="model">utility.key.change.campaign</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="بدء" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_launch" string="تنفيذ" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'planned')]}"/>
                    <button name="action_complete" string="إكمال" type="object" attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <button name="action_cancel" string="إلغاء" type="object" attrs="{'invisible': [('state', '=', 'completed')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tokens" type="object" class="oe_stat_button" icon="fa-key">
                            <field name="token_ids" widget="statinfo" string="التوكنات"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="reference" readonly="1"/>
                            <field name="provider_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="operator_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="key_revision_from"/>
                            <field name="meter_count"/>
                        </group>
                        <group>
                            <field name="key_revision_to"/>
                            <field name="total_tokens_generated"/>
                            <field name="total_tokens_failed"/>
                        </group>
                    </group>
                    <field name="meter_ids" widget="many2many_tags"/>
                    <field name="notes" placeholder="ملاحظات..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_key_change_campaign_all" model="ir.actions.act_window">
        <field name="name">حملات تغيير المفتاح</field>
        <field name="res_model">utility.key.change.campaign</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
