<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_utility_token_tree" model="ir.ui.view">
    <field name="name">utility.token.tree</field>
    <field name="model">utility.token</field>
    <field name="arch" type="xml">
      <tree>
        <field name="token_number"/>
        <field name="sale_id"/>
        <field name="customer_id"/>
        <field name="meter_id"/>
        <field name="amount" widget="monetary"/>
        <field name="kwh"/>
        <field name="status" decoration-success="status=='success'" decoration-danger="status in ('failed','cancelled')"/>
        <field name="request_date"/>
        <field name="response_date"/>
      </tree>
    </field>
  </record>

  <record id="view_utility_token_form" model="ir.ui.view">
    <field name="name">utility.token.form</field>
    <field name="model">utility.token</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="status" widget="statusbar" statusbar_visible="pending,success,failed"/>
          <button name="action_retry" string="Retry" type="object" states="failed" class="btn-primary"/>
          <button name="action_cancel" string="Cancel Token" type="object" states="pending,retry" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="token_number"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="token_identifier"/>
              <field name="sequence_number"/>
              <field name="sale_id"/>
              <field name="customer_id"/>
              <field name="account_id"/>
            </group>
            <group>
              <field name="meter_id"/>
              <field name="tariff_id"/>
              <field name="amount" widget="monetary"/>
              <field name="kwh"/>
              <field name="sts_server"/>
            </group>
          </group>
          <group string="Request / Response">
            <group>
              <field name="request_date"/>
              <field name="raw_request" nolabel="1"/>
            </group>
            <group>
              <field name="response_date"/>
              <field name="response_code"/>
              <field name="response_message"/>
              <field name="raw_response" nolabel="1"/>
            </group>
          </group>
          <group string="Retry Info">
            <field name="retry_count"/>
            <field name="last_retry_date"/>
          </group>
        </sheet>
        <div class="oe_chatter">
          <field name="message_ids" widget="mail_thread"/>
        </div>
      </form>
    </field>
  </record>

  <record id="action_utility_token" model="ir.actions.act_window">
    <field name="name">Tokens</field>
    <field name="res_model">utility.token</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
