<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_token_tree" model="ir.ui.view">
        <field name="name">utility.token.tree</field>
        <field name="model">utility.token</field>
        <field name="arch" type="xml">
            <tree decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status in ('pending', 'retry')" decoration-muted="status == 'cancelled'">
                <field name="token_number"/>
                <field name="account_id"/>
                <field name="meter_id"/>
                <field name="token_type" widget="badge"/>
                <field name="amount" widget="monetary"/>
                <field name="kwh"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status in ('pending', 'retry')" decoration-muted="status == 'cancelled'"/>
                <field name="delivery_state"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_token_form" model="ir.ui.view">
        <field name="name">utility.token.form</field>
        <field name="model">utility.token</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_request_token" string="طلب توكن" type="object" class="oe_highlight" attrs="{'invisible': [('status', 'in', ('success', 'cancelled'))]}"/>
                    <button name="action_retry" string="إعادة محاولة" type="object" attrs="{'invisible': [('status', 'in', ('success', 'cancelled'))]}"/>
                    <button name="action_cancel" string="إلغاء" type="object" attrs="{'invisible': [('status', '=', 'success')]}"/>
                    <button name="action_resend_sms" string="إعادة إرسال SMS" type="object" attrs="{'invisible': ['|', ('status', '!=', 'success'), ('delivery_state', '=', 'sms_sent')]}"/>
                    <button name="action_reprint" string="إعادة طباعة" type="object" attrs="{'invisible': [('status', '!=', 'success')]}"/>
                    <button name="action_mark_delivered" string="تحديد كمُسلّم" type="object" attrs="{'invisible': [('delivery_state', '=', 'delivered')]}"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,success"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="token_number" readonly="1"/>
                            <field name="token_identifier" readonly="1"/>
                            <field name="token_type"/>
                            <field name="mask_display" attrs="{'invisible': [('token_number', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="account_id" readonly="1"/>
                            <field name="meter_id" readonly="1"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="vending_request_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="kwh"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="response_date"/>
                            <field name="response_code"/>
                            <field name="delivery_state"/>
                        </group>
                    </group>
                    <group>
                        <field name="retry_count" attrs="{'invisible': [('retry_count', '=', 0)]}"/>
                        <field name="resend_count" attrs="{'invisible': [('resend_count', '=', 0)]}"/>
                        <field name="reprint_count" attrs="{'invisible': [('reprint_count', '=', 0)]}"/>
                    </group>
                    <notebook>
                        <page string="معلومات المزود" name="provider_info">
                            <group>
                                <field name="sts_server"/>
                                <field name="provider_reference"/>
                                <field name="raw_request" groups="base.group_no_one"/>
                                <field name="raw_response" groups="base.group_no_one"/>
                            </group>
                        </page>
                        <page string="رسالة الرد" name="response">
                            <field name="response_message"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_utility_token_search" model="ir.ui.view">
        <field name="name">utility.token.search</field>
        <field name="model">utility.token</field>
        <field name="arch" type="xml">
            <search>
                <field name="token_number"/>
                <field name="account_id"/>
                <field name="meter_id"/>
                <field name="vending_request_id"/>
                <filter name="pending" string="معلق" domain="[('status', '=', 'pending')]"/>
                <filter name="success" string="ناجح" domain="[('status', '=', 'success')]"/>
                <filter name="failed" string="فاشل" domain="[('status', '=', 'failed')]"/>
                <filter name="credit" string="رصيد" domain="[('token_type', '=', 'credit')]"/>
                <filter name="management" string="إدارة" domain="[('token_type', '=', 'management')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_status" string="الحالة" context="{'group_by': 'status'}"/>
                    <filter name="group_type" string="النوع" context="{'group_by': 'token_type'}"/>
                    <filter name="group_delivery" string="التسليم" context="{'group_by': 'delivery_state'}"/>
                    <filter name="group_date" string="التاريخ" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_token_all" model="ir.actions.act_window">
        <field name="name">رموز STS</field>
        <field name="res_model">utility.token</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_utility_token_search"/>
    </record>

    <record id="action_utility_token_credit" model="ir.actions.act_window">
        <field name="name">رموز رصيد</field>
        <field name="res_model">utility.token</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('token_type', '=', 'credit')]</field>
    </record>

    <record id="action_utility_token_management" model="ir.actions.act_window">
        <field name="name">رموز إدارة</field>
        <field name="res_model">utility.token</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('token_type', '=', 'management')]</field>
    </record>

    <record id="action_utility_token_failed" model="ir.actions.act_window">
        <field name="name">رموز فاشلة</field>
        <field name="res_model">utility.token</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('status', '=', 'failed')]</field>
    </record>
</odoo>
