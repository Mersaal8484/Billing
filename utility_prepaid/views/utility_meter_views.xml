<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_meter_form_prepaid" model="ir.ui.view">
        <field name="name">utility.meter.form.prepaid</field>
        <field name="model">utility.meter</field>
        <field name="inherit_id" ref="utility_core.view_utility_meter_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_request_ami_reading" type="object" string="طلب قراءة AMI"
                        class="btn-secondary" attrs="{'invisible': [('payment_type', '!=', 'postpaid')]}"/>
            </xpath>
            <xpath expr="//page[@name='reading_history']" position="after">
                <page name="smart_meter" string="الدفع المسبق والاتصال الذكي">
                    <group>
                        <group string="إعدادات STS" attrs="{'invisible': [('payment_type', '!=', 'prepaid')]}">
                            <field name="sts_key_revision"/>
                        </group>
                        <group string="الاتصال الذكي" attrs="{'invisible': [('payment_type', '!=', 'postpaid')]}">
                            <field name="communication_type"/>
                            <field name="sim_number" attrs="{'invisible': [('communication_type', 'not in', ('gsm', 'nbiot'))]}"/>
                        </group>
                    </group>
                    <field name="qr_code_url" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
