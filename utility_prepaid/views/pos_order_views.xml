<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_inherit_utility_prepaid" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.utility_prepaid</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_prepaid_vending"/>
                <field name="utility_account_id" attrs="{'invisible': [('is_prepaid_vending', '=', False)]}"/>
                <field name="utility_meter_id" attrs="{'invisible': [('is_prepaid_vending', '=', False)]}"/>
                <field name="vending_request_id" attrs="{'invisible': [('is_prepaid_vending', '=', False)]}"/>
                <field name="vending_amount" widget="monetary" attrs="{'invisible': [('is_prepaid_vending', '=', False)]}"/>
                <field name="vending_kwh" attrs="{'invisible': [('is_prepaid_vending', '=', False)]}"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_inherit_utility_prepaid" model="ir.ui.view">
        <field name="name">pos.order.tree.inherit.utility_prepaid</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="is_prepaid_vending" optional="hide"/>
                <field name="utility_account_id" optional="hide"/>
                <field name="vending_kwh" optional="hide"/>
                <field name="token_status" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_search_inherit_utility_prepaid" model="ir.ui.view">
        <field name="name">pos.order.search.inherit.utility_prepaid</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='invoiced']" position="after">
                <separator/>
                <filter name="is_prepaid_vending" string="بيع مسبق" domain="[('is_prepaid_vending', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_pos_order_prepaid" model="ir.actions.act_window">
        <field name="name">أوامر POS - بيع مسبق</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_prepaid_vending', '=', True)]</field>
        <field name="search_view_id" ref="point_of_sale.view_pos_order_filter"/>
    </record>
</odoo>
