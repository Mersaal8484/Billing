<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_utility_sale_tree" model="ir.ui.view">
    <field name="name">utility.sale.tree</field>
    <field name="model">utility.sale</field>
    <field name="arch" type="xml">
      <tree>
        <field name="receipt_number"/>
        <field name="date"/>
        <field name="customer_id"/>
        <field name="amount_paid" widget="monetary"/>
        <field name="kwh_purchased"/>
        <field name="payment_method"/>
        <field name="state" decoration-danger="state in ('cancelled','reversed')" decoration-success="state=='completed'" decoration-info="state=='token_generated'"/>
      </tree>
    </field>
  </record>

  <record id="view_utility_sale_form" model="ir.ui.view">
    <field name="name">utility.sale.form</field>
    <field name="model">utility.sale</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,token_generated,completed"/>
          <button name="action_confirm" string="Confirm" type="object" states="draft" class="btn-primary"/>
          <button name="action_generate_token" string="Generate Token" type="object" states="confirmed" class="btn-primary"/>
          <button name="action_complete" string="Complete" type="object" states="token_generated" class="btn-primary"/>
          <button name="action_cancel" string="Cancel" type="object" states="draft,confirmed,token_generated" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="receipt_number" readonly="1"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="date"/>
              <field name="customer_id" options="{'no_create': True}"/>
              <field name="account_id" options="{'no_create': True}"/>
              <field name="meter_id" options="{'no_create': True}"/>
              <field name="tariff_id" options="{'no_create': True}"/>
            </group>
            <group>
              <field name="payment_method"/>
              <field name="payment_reference"/>
              <field name="reference_number"/>
              <field name="operator_id"/>
              <field name="token_status"/>
            </group>
          </group>
          <notebook>
            <page string="Amount &amp; kWh">
              <group>
                <group>
                  <field name="amount_paid" widget="monetary"/>
                  <field name="kwh_purchased"/>
                  <field name="unit_price"/>
                </group>
                <group>
                  <field name="energy_charge" widget="monetary"/>
                  <field name="fixed_charge" widget="monetary"/>
                  <field name="service_charge" widget="monetary"/>
                  <field name="fuel_adjustment" widget="monetary"/>
                  <field name="tax_amount" widget="monetary"/>
                  <field name="total_charge" widget="monetary"/>
                </group>
              </group>
              <group>
                <field name="balance_before" widget="monetary"/>
                <field name="balance_after" widget="monetary"/>
              </group>
            </page>
            <page string="Sale Lines">
              <field name="line_ids">
                <tree editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="quantity"/>
                  <field name="unit"/>
                  <field name="unit_price"/>
                  <field name="subtotal" widget="monetary"/>
                </tree>
              </field>
            </page>
            <page string="Token">
              <group>
                <field name="token_id"/>
              </group>
            </page>
            <page string="Notes">
              <field name="notes" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids" widget="mail_followers"/>
          <field name="activity_ids" widget="mail_activity"/>
          <field name="message_ids" widget="mail_thread"/>
        </div>
      </form>
    </field>
  </record>

  <record id="view_utility_sale_search" model="ir.ui.view">
    <field name="name">utility.sale.search</field>
    <field name="model">utility.sale</field>
    <field name="arch" type="xml">
      <search>
        <field name="receipt_number"/>
        <field name="customer_id"/>
        <field name="account_id"/>
        <field name="meter_id"/>
        <field name="state" filter_domain="[('state','ilike',self)]"/>
        <field name="payment_method"/>
        <filter name="group_date" string="Date" date="date" context="{'group_by':'date'}"/>
        <separator/>
        <filter name="group_method" string="Payment Method" context="{'group_by':'payment_method'}"/>
        <filter name="group_state" string="State" context="{'group_by':'state'}"/>
        <filter name="group_operator" string="Operator" context="{'group_by':'operator_id'}"/>
        <separator/>
        <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
        <filter name="filter_confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
        <filter name="filter_completed" string="Completed" domain="[('state','=','completed')]"/>
      </search>
    </field>
  </record>

  <record id="action_utility_sale" model="ir.actions.act_window">
    <field name="name">Prepaid Sales</field>
    <field name="res_model">utility.sale</field>
    <field name="view_mode">tree,form</field>
    <field name="search_view_id" ref="view_utility_sale_search"/>
    <field name="help" type="html">
      <p>Manage prepaid electricity token sales.</p>
    </field>
  </record>
</odoo>
