<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ami_event_tree" model="ir.ui.view">
        <field name="name">utility.prepaid.ami.event.tree</field>
        <field name="model">utility.prepaid.ami.event</field>
        <field name="arch" type="xml">
            <tree decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'" decoration-muted="processed == True">
                <field name="reference"/>
                <field name="event_date"/>
                <field name="event_type" widget="badge"/>
                <field name="meter_id"/>
                <field name="account_id"/>
                <field name="event_value"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'" decoration-info="severity == 'info'"/>
                <field name="processed" widget="boolean_toggle"/>
                <field name="notification_sent"/>
            </tree>
        </field>
    </record>

    <record id="view_ami_event_form" model="ir.ui.view">
        <field name="name">utility.prepaid.ami.event.form</field>
        <field name="model">utility.prepaid.ami.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process" string="معالجة" type="object" class="oe_highlight" attrs="{'invisible': [('processed', '=', True)]}"/>
                    <field name="processed" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="event_date"/>
                            <field name="event_type"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="meter_id"/>
                            <field name="account_id"/>
                            <field name="token_id"/>
                            <field name="event_value"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="processed"/>
                            <field name="processed_date"/>
                            <field name="notification_sent"/>
                            <field name="support_ticket_created"/>
                        </group>
                        <group>
                            <field name="source"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="بيانات الحدث" name="event_data">
                            <field name="event_data"/>
                        </page>
                        <page string="بيانات خام" name="raw" groups="base.group_no_one">
                            <field name="raw_payload"/>
                        </page>
                        <page string="نتيجة المعالجة" name="result">
                            <field name="processing_result"/>
                        </page>
                        <page string="ملاحظات" name="notes">
                            <field name="notes" placeholder="ملاحظات..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ami_event_search" model="ir.ui.view">
        <field name="name">utility.prepaid.ami.event.search</field>
        <field name="model">utility.prepaid.ami.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="meter_id"/>
                <field name="account_id"/>
                <filter name="unprocessed" string="غير معالجة" domain="[('processed', '=', False)]"/>
                <filter name="low_credit" string="رصيد منخفض" domain="[('event_type', '=', 'low_credit')]"/>
                <filter name="token_accepted" string="قبول التوكن" domain="[('event_type', '=', 'token_accepted')]"/>
                <filter name="token_rejected" string="رفض التوكن" domain="[('event_type', '=', 'token_rejected')]"/>
                <filter name="critical" string="حرج" domain="[('severity', '=', 'critical')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_type" string="النوع" context="{'group_by': 'event_type'}"/>
                    <filter name="group_severity" string="الخطورة" context="{'group_by': 'severity'}"/>
                    <filter name="group_processed" string="المعالجة" context="{'group_by': 'processed'}"/>
                    <filter name="group_date" string="التاريخ" context="{'group_by': 'event_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ami_event_all" model="ir.actions.act_window">
        <field name="name">أحداث AMI</field>
        <field name="res_model">utility.prepaid.ami.event</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_ami_event_search"/>
    </record>

    <record id="action_ami_event_low_credit" model="ir.actions.act_window">
        <field name="name">أحداث الرصيد المنخفض</field>
        <field name="res_model">utility.prepaid.ami.event</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('event_type', '=', 'low_credit')]</field>
    </record>

    <record id="action_ami_event_token_accepted" model="ir.actions.act_window">
        <field name="name">أحداث قبول التوكن</field>
        <field name="res_model">utility.prepaid.ami.event</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('event_type', '=', 'token_accepted')]</field>
    </record>

    <record id="action_ami_event_token_rejected" model="ir.actions.act_window">
        <field name="name">أحداث رفض التوكن</field>
        <field name="res_model">utility.prepaid.ami.event</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('event_type', '=', 'token_rejected')]</field>
    </record>
</odoo>
