<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prepaid_dashboard_form" model="ir.ui.view">
        <field name="name">utility.prepaid.dashboard.form</field>
        <field name="model">utility.prepaid.dashboard</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_refresh" string="تحديث" type="object" class="oe_highlight" icon="fa-refresh"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="اليوم">
                        <group>
                            <div class="o_row">
                                <span class="oe_grey">عمليات البيع:</span>
                                <field name="today_vending_count" class="oe_inline"/>
                            </div>
                            <div class="o_row">
                                <span class="oe_grey">المبلغ:</span>
                                <field name="today_vending_amount" widget="monetary" class="oe_inline"/>
                            </div>
                            <div class="o_row">
                                <span class="oe_grey">kWh مباعة:</span>
                                <field name="today_kwh_sold" class="oe_inline"/>
                            </div>
                        </group>
                    </group>
                    <group string="هذا الشهر">
                        <group>
                            <div class="o_row">
                                <span class="oe_grey">عمليات البيع:</span>
                                <field name="month_vending_count" class="oe_inline"/>
                            </div>
                            <div class="o_row">
                                <span class="oe_grey">المبلغ:</span>
                                <field name="month_vending_amount" widget="monetary" class="oe_inline"/>
                            </div>
                            <div class="o_row">
                                <span class="oe_grey">kWh مباعة:</span>
                                <field name="month_kwh_sold" class="oe_inline"/>
                            </div>
                        </group>
                    </group>
                    <group string="حالة التوكنات">
                        <group>
                            <div class="o_row">
                                <span class="oe_grey">معلقة:</span>
                                <field name="pending_tokens" class="oe_inline"/>
                            </div>
                            <div class="o_row">
                                <span class="oe_grey">ناجحة:</span>
                                <field name="successful_tokens" class="oe_inline"/>
                            </div>
                        </group>
                        <group>
                            <div class="o_row">
                                <span class="oe_grey">فاشلة:</span>
                                <field name="failed_tokens" class="oe_inline"/>
                            </div>
                            <div>
                                <button name="action_view_pending_tokens" type="object" class="oe_link" string="عرض المعلقة"/>
                                <button name="action_view_failed_tokens" type="object" class="oe_link" string="عرض الفاشلة"/>
                            </div>
                        </group>
                    </group>
                    <group string="العمليات المعلقة">
                        <group>
                            <div class="o_row">
                                <span class="oe_grey">ورديات مفتوحة:</span>
                                <field name="open_shifts" class="oe_inline"/>
                            </div>
                            <div class="o_row">
                                <span class="oe_grey">طلبات عكس معلقة:</span>
                                <field name="pending_reversals" class="oe_inline"/>
                            </div>
                        </group>
                        <group>
                            <div class="o_row">
                                <span class="oe_grey">تسويات معلقة:</span>
                                <field name="pending_adjustments" class="oe_inline"/>
                            </div>
                            <div>
                                <button name="action_view_open_shifts" type="object" class="oe_link" string="عرض الورديات"/>
                                <button name="action_view_pending_reversals" type="object" class="oe_link" string="عرض العكس"/>
                            </div>
                        </group>
                    </group>
                    <group string="الملخص المالي">
                        <group>
                            <div class="o_row">
                                <span class="oe_grey">ديون مستقطعة:</span>
                                <field name="total_debt_recovered" widget="monetary" class="oe_inline"/>
                            </div>
                            <div class="o_row">
                                <span class="oe_grey">مبالغ معكوسة:</span>
                                <field name="total_reversals_amount" widget="monetary" class="oe_inline"/>
                            </div>
                        </group>
                        <group>
                            <div class="o_row">
                                <span class="oe_grey">مبالغ تسوية:</span>
                                <field name="total_adjustments_amount" widget="monetary" class="oe_inline"/>
                            </div>
                            <div>
                                <button name="action_view_today_vending" type="object" class="oe_link" string="عرض بيع اليوم"/>
                            </div>
                        </group>
                    </group>
                    <group string="أعلى العدادات مبيعاً">
                        <field name="top_meters_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prepaid_dashboard" model="ir.actions.act_window">
        <field name="name">لوحة معلومات الدفع المسبق</field>
        <field name="res_model">utility.prepaid.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
