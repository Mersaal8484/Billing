<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vending_reversal_tree" model="ir.ui.view">
        <field name="name">utility.vending.reversal.tree</field>
        <field name="model">utility.vending.reversal</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ('cancelled', 'rejected')" decoration-success="state == 'completed'" decoration-warning="state in ('draft', 'submitted', 'under_review')" decoration-info="state in ('approved', 'sts_reversed', 'refund_issued')">
                <field name="reference"/>
                <field name="date"/>
                <field name="vending_request_id"/>
                <field name="account_id"/>
                <field name="meter_id"/>
                <field name="amount" widget="monetary"/>
                <field name="reason_id"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-warning="state in ('draft', 'submitted', 'under_review')" decoration-info="state in ('approved', 'sts_reversed', 'refund_issued')" decoration-muted="state in ('cancelled', 'rejected')"/>
            </tree>
        </field>
    </record>

    <record id="view_vending_reversal_form" model="ir.ui.view">
        <field name="name">utility.vending.reversal.form</field>
        <field name="model">utility.vending.reversal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="تقديم" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_review" string="مراجعة" type="object" attrs="{'invisible': [('state', '!=', 'submitted')]}"/>
                    <button name="action_validate_provider" string="تحقق من المزود" type="object" attrs="{'invisible': [('state', '!=', 'under_review')]}"/>
                    <button name="action_approve" string="موافقة" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ('provider_validation', 'under_review'))]}"/>
                    <button name="action_reverse_sts" string="عكس لدى STS" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'approved')]}"/>
                    <button name="action_issue_refund" string="إصدار استرداد" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'sts_reversed')]}"/>
                    <button name="action_complete" string="إكمال" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'refund_issued')]}"/>
                    <button name="action_reject" string="رفض" type="object" attrs="{'invisible': [('state', 'in', ('completed', 'cancelled'))]}"/>
                    <button name="action_cancel" string="إلغاء" type="object" attrs="{'invisible': [('state', 'in', ('completed', 'sts_reversed', 'refund_issued'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,approved,sts_reversed,refund_issued,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="vending_request_id" readonly="1"/>
                            <field name="token_id" readonly="1"/>
                            <field name="reversal_type"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="reason_id"/>
                            <field name="amount" widget="monetary"/>
                            <field name="operator_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="account_id" readonly="1"/>
                        <field name="meter_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="approved_by" attrs="{'invisible': [('approved_by', '=', False)]}"/>
                    </group>
                    <field name="reason_details" placeholder="تفاصيل سبب العكس..."/>
                    <notebook>
                        <page string="معاملة STS" name="sts">
                            <group>
                                <field name="sts_transaction_id"/>
                            </group>
                        </page>
                        <page string="ملاحظات" name="notes">
                            <field name="notes" placeholder="ملاحظات..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_vending_reversal_all" model="ir.actions.act_window">
        <field name="name">طلبات العكس</field>
        <field name="res_model">utility.vending.reversal</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_reversal_reason_tree" model="ir.ui.view">
        <field name="name">utility.reversal.reason.tree</field>
        <field name="model">utility.reversal.reason</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="category" widget="badge"/>
                <field name="requires_approval"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_reversal_reason_form" model="ir.ui.view">
        <field name="name">utility.reversal.reason.form</field>
        <field name="model">utility.reversal.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="requires_approval"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="وصف السبب..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_reversal_reason_all" model="ir.actions.act_window">
        <field name="name">أسباب العكس</field>
        <field name="res_model">utility.reversal.reason</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
