<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_debt_policy_tree" model="ir.ui.view">
        <field name="name">utility.prepaid.debt.policy.tree</field>
        <field name="model">utility.prepaid.debt.policy</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="recovery_method"/>
                <field name="recovery_percentage"/>
                <field name="max_recovery_per_vending" widget="monetary"/>
                <field name="scope"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_debt_policy_form" model="ir.ui.view">
        <field name="name">utility.prepaid.debt.policy.form</field>
        <field name="model">utility.prepaid.debt.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="recovery_method"/>
                            <field name="scope"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="إعدادات الاستقطاع">
                        <group>
                            <field name="recovery_percentage" attrs="{'invisible': [('recovery_method', '!=', 'percentage')]}"/>
                            <field name="fixed_amount" attrs="{'invisible': [('recovery_method', '!=', 'fixed')]}"/>
                            <field name="installment_amount" attrs="{'invisible': [('recovery_method', '!=', 'installment')]}"/>
                        </group>
                        <group>
                            <field name="max_recovery_per_vending"/>
                            <field name="min_energy_percentage"/>
                            <field name="recovery_account_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="النطاق" name="scope">
                            <group>
                                <field name="category_ids" widget="many2many_tags" attrs="{'invisible': [('scope', '!=', 'category')]}"/>
                                <field name="subscriber_ids" widget="many2many_tags" attrs="{'invisible': [('scope', '!=', 'subscriber')]}"/>
                                <field name="debt_types"/>
                                <field name="priority_debt_account_ids" widget="many2many_tags" attrs="{'invisible': [('debt_types', '!=', 'specific')]}"/>
                            </group>
                        </page>
                        <page string="بنود السياسة" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="debt_type"/>
                                    <field name="priority"/>
                                    <field name="recovery_percentage"/>
                                    <field name="max_amount" widget="monetary"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                        <page string="الوصف" name="description">
                            <field name="description" placeholder="وصف السياسة..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_debt_policy_all" model="ir.actions.act_window">
        <field name="name">سياسات الاستقطاع</field>
        <field name="res_model">utility.prepaid.debt.policy</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_debt_recovery_tree" model="ir.ui.view">
        <field name="name">utility.prepaid.debt.recovery.tree</field>
        <field name="model">utility.prepaid.debt.recovery</field>
        <field name="arch" type="xml">
            <tree>
                <field name="reference"/>
                <field name="date"/>
                <field name="policy_id"/>
                <field name="account_id"/>
                <field name="debt_amount" widget="monetary"/>
                <field name="recovered_amount" widget="monetary"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="action_debt_recovery_all" model="ir.actions.act_window">
        <field name="name">عمليات الاستقطاع</field>
        <field name="res_model">utility.prepaid.debt.recovery</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
