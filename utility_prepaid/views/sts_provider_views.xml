<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sts_provider_tree" model="ir.ui.view">
        <field name="name">utility.sts.provider.tree</field>
        <field name="model">utility.sts.provider</field>
        <field name="arch" type="xml">
            <tree decoration-success="health_state == 'healthy'" decoration-warning="health_state == 'degraded'" decoration-danger="health_state == 'down'">
                <field name="name"/>
                <field name="code"/>
                <field name="provider_type" widget="badge"/>
                <field name="health_state" widget="badge" decoration-success="health_state == 'healthy'" decoration-warning="health_state == 'degraded'" decoration-danger="health_state == 'down'" decoration-muted="health_state == 'unknown'"/>
                <field name="is_default"/>
                <field name="active"/>
                <field name="last_health_check"/>
            </tree>
        </field>
    </record>

    <record id="view_sts_provider_form" model="ir.ui.view">
        <field name="name">utility.sts.provider.form</field>
        <field name="model">utility.sts.provider</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_health_check" string="فحص الصحة" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="provider_type"/>
                            <field name="is_default"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="health_state" widget="badge"/>
                            <field name="last_health_check"/>
                            <field name="last_error" attrs="{'invisible': [('last_error', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="إعدادات الاتصال">
                        <group>
                            <field name="base_url"/>
                            <field name="timeout"/>
                            <field name="max_retries"/>
                        </group>
                        <group>
                            <field name="api_key" password="True"/>
                            <field name="api_secret" password="True"/>
                            <field name="retry_interval"/>
                        </group>
                    </group>
                    <group>
                        <field name="config_json" groups="base.group_no_one"/>
                    </group>
                    <field name="description" placeholder="وصف المزود..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sts_provider_all" model="ir.actions.act_window">
        <field name="name">مزودي STS</field>
        <field name="res_model">utility.sts.provider</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
