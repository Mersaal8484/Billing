<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_transaction_tree" model="ir.ui.view">
        <field name="name">utility.transaction.tree</field>
        <field name="model">utility.transaction</field>
        <field name="arch" type="xml">
            <tree>
                <field name="reference"/>
                <field name="date"/>
                <field name="transaction_type" widget="badge"/>
                <field name="account_id"/>
                <field name="meter_id"/>
                <field name="amount" widget="monetary"/>
                <field name="operator_id"/>
                <field name="pos_order_id"/>
                <field name="vending_request_id"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_transaction_form" model="ir.ui.view">
        <field name="name">utility.transaction.form</field>
        <field name="model">utility.transaction</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="date"/>
                            <field name="transaction_type"/>
                            <field name="amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="account_id"/>
                            <field name="meter_id"/>
                            <field name="operator_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="vending_request_id"/>
                        <field name="pos_order_id"/>
                        <field name="reversal_id"/>
                        <field name="adjustment_id"/>
                        <field name="account_move_id"/>
                        <field name="payment_id"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_utility_transaction_search" model="ir.ui.view">
        <field name="name">utility.transaction.search</field>
        <field name="model">utility.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="account_id"/>
                <field name="meter_id"/>
                <filter name="vending" string="بيع" domain="[('transaction_type', '=', 'vending')]"/>
                <filter name="reversal" string="عكس" domain="[('transaction_type', '=', 'reversal')]"/>
                <filter name="adjustment" string="تسوية" domain="[('transaction_type', '=', 'adjustment')]"/>
                <filter name="refund" string="استرداد" domain="[('transaction_type', '=', 'refund')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_type" string="النوع" context="{'group_by': 'transaction_type'}"/>
                    <filter name="group_date" string="التاريخ" context="{'group_by': 'date:day'}"/>
                    <filter name="group_operator" string="المشغل" context="{'group_by': 'operator_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_transaction_all" model="ir.actions.act_window">
        <field name="name">المعاملات</field>
        <field name="res_model">utility.transaction</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_utility_transaction_search"/>
    </record>
</odoo>
