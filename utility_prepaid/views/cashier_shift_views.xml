<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit cashier shift tree view from utility_billing to add prepaid columns -->
    <record id="view_cashier_shift_tree_inherit_prepaid" model="ir.ui.view">
        <field name="name">utility.cashier.shift.tree.inherit.prepaid</field>
        <field name="model">utility.cashier.shift</field>
        <field name="inherit_id" ref="utility_billing.view_cashier_shift_tree"/>
        <field name="arch" type="xml">
            <field name="total_collections" position="after">
                <field name="prepaid_total" widget="monetary"/>
            </field>
        </field>
    </record>

    <!-- Inherit cashier shift form view from utility_billing to add POS / vending fields -->
    <record id="view_cashier_shift_form_inherit_prepaid" model="ir.ui.view">
        <field name="name">utility.cashier.shift.form.inherit.prepaid</field>
        <field name="model">utility.cashier.shift</field>
        <field name="inherit_id" ref="utility_billing.view_cashier_shift_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_vending" type="object" class="oe_stat_button" icon="fa-shopping-cart" attrs="{'invisible': [('vending_count', '=', 0)]}">
                    <field name="vending_count" widget="statinfo" string="عمليات البيع"/>
                </button>
            </div>
            <field name="cashier_id" position="after">
                <field name="pos_session_id"/>
            </field>
            <field name="total_collections" position="after">
                <field name="prepaid_total" widget="monetary"/>
            </field>
            <group name="financial_summary" position="after">
                <group string="تفصيل الدفع المسبق" name="prepaid_details">
                    <group>
                        <field name="prepaid_cash_total" widget="monetary"/>
                        <field name="prepaid_bank_total" widget="monetary"/>
                    </group>
                </group>
            </group>
            <notebook position="inside">
                <page string="طلبات البيع" name="vending_requests">
                    <field name="vending_request_ids">
                        <tree>
                            <field name="reference"/>
                            <field name="account_id"/>
                            <field name="meter_id"/>
                            <field name="gross_amount" widget="monetary"/>
                            <field name="state"/>
                            <field name="vending_date"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Prepaid Cashier Shift Window Actions -->
    <record id="action_cashier_shift_all" model="ir.actions.act_window">
        <field name="name">الورديات</field>
        <field name="res_model">utility.cashier.shift</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="utility_billing.view_cashier_shift_search"/>
    </record>

    <record id="action_cashier_shift_open" model="ir.actions.act_window">
        <field name="name">ورديات مفتوحة</field>
        <field name="res_model">utility.cashier.shift</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'open')]</field>
    </record>
</odoo>
