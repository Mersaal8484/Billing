<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cashier_shift_tree" model="ir.ui.view">
        <field name="name">utility.cashier.shift.tree.prepaid</field>
        <field name="model">utility.cashier.shift</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'verified'" decoration-warning="state in ('open', 'closing')" default_order="start_time desc">
                <field name="name"/>
                <field name="cashier_id"/>
                <field name="pos_session_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="prepaid_total" widget="monetary" sum="إجمالي الدفع المسبق"/>
                <field name="prepaid_cash_total" widget="monetary" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_cashier_shift_form" model="ir.ui.view">
        <field name="name">utility.cashier.shift.form.prepaid</field>
        <field name="model">utility.cashier.shift</field>
        <field name="arch" type="xml">
            <form string="وردية كاشير الدفع المسبق">
                <header>
                    <button name="action_close" type="object" string="إغلاق الوردية" class="btn-primary" states="open"/>
                    <button name="action_verify" type="object" string="اعتماد" class="btn-primary" states="closing" groups="utility_prepaid.group_utility_prepaid_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closing,verified"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vending" type="object" class="oe_stat_button" icon="fa-shopping-cart" attrs="{'invisible': [('vending_count', '=', 0)]}">
                            <field name="vending_count" widget="statinfo" string="عمليات البيع"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="cashier_id" attrs="{'readonly': [('state', '!=', 'open')]}"/>
                            <field name="pos_session_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="start_time" readonly="1"/>
                            <field name="end_time" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="row">
                        <div class="col-12 col-lg-6">
                            <div class="card o_settings_card">
                                <div class="card-header"><h4 class="mb-0">ملخص الدفع المسبق</h4></div>
                                <div class="card-body">
                                    <group>
                                        <field name="prepaid_total" widget="monetary" readonly="1"/>
                                        <field name="prepaid_cash_total" widget="monetary" readonly="1"/>
                                        <field name="prepaid_bank_total" widget="monetary" readonly="1"/>
                                        <field name="total_transactions" readonly="1"/>
                                    </group>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="card o_settings_card">
                                <div class="card-header"><h4 class="mb-0">مطابقة النقدية</h4></div>
                                <div class="card-body">
                                    <group>
                                        <field name="opening_balance" widget="monetary" attrs="{'readonly': [('state', '!=', 'open')]}"/>
                                        <field name="expected_balance" widget="monetary" readonly="1"/>
                                        <field name="closing_balance" widget="monetary" attrs="{'readonly': [('state', '=', 'verified')]}"/>
                                        <field name="difference" widget="monetary" readonly="1"/>
                                    </group>
                                </div>
                            </div>
                        </div>
                    </div>
                    <notebook>
                        <page string="طلبات البيع">
                            <field name="vending_request_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="reference"/>
                                    <field name="account_id"/>
                                    <field name="meter_id"/>
                                    <field name="gross_amount" widget="monetary"/>
                                    <field name="state" widget="badge"/>
                                    <field name="vending_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ملاحظات"><field name="notes"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cashier_shift_search" model="ir.ui.view">
        <field name="name">utility.cashier.shift.search.prepaid</field>
        <field name="model">utility.cashier.shift</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="cashier_id"/>
                <filter string="مفتوحة" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="وردياتي" name="my_shifts" domain="[('cashier_id', '=', uid)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter string="الكاشير" name="group_cashier" context="{'group_by': 'cashier_id'}"/>
                    <filter string="الحالة" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cashier_shift_all" model="ir.actions.act_window">
        <field name="name">ورديات الدفع المسبق</field>
        <field name="res_model">utility.cashier.shift</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cashier_shift_search"/>
    </record>
    <record id="action_cashier_shift_open" model="ir.actions.act_window">
        <field name="name">ورديات مفتوحة</field>
        <field name="res_model">utility.cashier.shift</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'open')]</field>
    </record>
</odoo>