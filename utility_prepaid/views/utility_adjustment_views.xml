<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_utility_adjustment_tree" model="ir.ui.view">
    <field name="name">utility.adjustment.tree</field>
    <field name="model">utility.adjustment</field>
    <field name="arch" type="xml">
      <tree>
        <field name="reference"/>
        <field name="date"/>
        <field name="customer_id"/>
        <field name="account_id"/>
        <field name="adjustment_type"/>
        <field name="amount" widget="monetary"/>
        <field name="state" decoration-success="state=='applied'" decoration-danger="state=='cancelled'" decoration-info="state=='approved'"/>
      </tree>
    </field>
  </record>

  <record id="view_utility_adjustment_form" model="ir.ui.view">
    <field name="name">utility.adjustment.form</field>
    <field name="model">utility.adjustment</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,approved,applied"/>
          <button name="action_approve" string="Approve" type="object" states="draft" class="btn-primary"/>
          <button name="action_apply" string="Apply" type="object" states="approved" class="btn-primary"/>
          <button name="action_cancel" string="Cancel" type="object" states="draft,approved" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="reference" readonly="1"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="date"/>
              <field name="customer_id" options="{'no_create': True}"/>
              <field name="account_id" options="{'no_create': True}"/>
              <field name="adjustment_type"/>
            </group>
            <group>
              <field name="amount" widget="monetary"/>
              <field name="balance_before" widget="monetary"/>
              <field name="balance_after" widget="monetary"/>
              <field name="operator_id"/>
              <field name="approved_by"/>
            </group>
          </group>
          <group string="Reason">
            <field name="reason" nolabel="1"/>
          </group>
        </sheet>
        <div class="oe_chatter">
          <field name="message_ids" widget="mail_thread"/>
        </div>
      </form>
    </field>
  </record>

  <record id="action_utility_adjustment" model="ir.actions.act_window">
    <field name="name">Adjustments</field>
    <field name="res_model">utility.adjustment</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
