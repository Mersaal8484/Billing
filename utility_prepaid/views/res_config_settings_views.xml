<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_utility_prepaid" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.utility_prepaid</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="الدفع المسبق" string="الدفع المسبق" groups="base.group_system" data-key="utility_prepaid">
                    <div class="row mt16 mb-4">
                        <div class="col-12 col-lg-6">
                            <div class="card o_settings_card">
                                <div class="card-header">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-shopping-cart fa-2x text-primary me-3" title="إعدادات البيع"/>
                                        <div>
                                            <h4 class="mb-0">إعدادات البيع</h4>
                                            <small class="text-muted">إعدادات عملية شحن الكهرباء</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="o_setting_box">
                                        <div class="o_setting_right_pane">
                                            <label for="prepaid_vending_product_id"/>
                                            <div class="text-muted">المنتج المستخدم لعمليات الشحن</div>
                                            <div class="mt-2">
                                                <field name="prepaid_vending_product_id"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-6">
                                            <label for="minimum_vending_amount" class="o_light_label"/>
                                            <field name="minimum_vending_amount"/>
                                        </div>
                                        <div class="col-6">
                                            <label for="maximum_vending_amount" class="o_light_label"/>
                                            <field name="maximum_vending_amount"/>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <field name="require_selected_customer"/>
                                        <label for="require_selected_customer" class="ms-2"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="require_open_cashier_shift"/>
                                        <label for="require_open_cashier_shift" class="ms-2"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="allow_multiple_meter_vending"/>
                                        <label for="allow_multiple_meter_vending" class="ms-2"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="card o_settings_card">
                                <div class="card-header">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-cloud fa-2x text-success me-3" title="إعدادات STS"/>
                                        <div>
                                            <h4 class="mb-0">إعدادات STS</h4>
                                            <small class="text-muted">مزود خدمة الرموز</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="o_setting_box">
                                        <div class="o_setting_right_pane">
                                            <label for="default_sts_provider_id"/>
                                            <div class="mt-2">
                                                <field name="default_sts_provider_id"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-6">
                                            <label for="sts_request_timeout" class="o_light_label"/>
                                            <field name="sts_request_timeout"/>
                                        </div>
                                        <div class="col-6">
                                            <label for="sts_max_retry_count" class="o_light_label"/>
                                            <field name="sts_max_retry_count"/>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <field name="enable_automatic_retry"/>
                                        <label for="enable_automatic_retry" class="ms-2"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="enable_provider_status_query"/>
                                        <label for="enable_provider_status_query" class="ms-2"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12 col-lg-6">
                            <div class="card o_settings_card">
                                <div class="card-header">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-key fa-2x text-warning me-3" title="إعدادات التوكن"/>
                                        <div>
                                            <h4 class="mb-0">إعدادات التوكن</h4>
                                            <small class="text-muted">التحكم بالرموز</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="mt-2">
                                        <field name="mask_token_in_tree_views"/>
                                        <label for="mask_token_in_tree_views" class="ms-2"/>
                                    </div>
                                    <div class="mt-2">
                                        <field name="allow_token_reprint"/>
                                        <label for="allow_token_reprint" class="ms-2"/>
                                    </div>
                                    <div class="row mt-2" attrs="{'invisible': [('allow_token_reprint', '=', False)]}">
                                        <div class="col-6">
                                            <label for="token_reprint_limit" class="o_light_label"/>
                                            <field name="token_reprint_limit"/>
                                        </div>
                                        <div class="col-6">
                                            <field name="require_reprint_reason"/>
                                            <label for="require_reprint_reason" class="ms-2"/>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <field name="allow_token_resend"/>
                                        <label for="allow_token_resend" class="ms-2"/>
                                    </div>
                                    <div class="mt-2" attrs="{'invisible': [('allow_token_resend', '=', False)]}">
                                        <label for="token_resend_limit" class="o_light_label"/>
                                        <field name="token_resend_limit"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="card o_settings_card">
                                <div class="card-header">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-calculator fa-2x text-info me-3" title="إعدادات المحاسبة"/>
                                        <div>
                                            <h4 class="mb-0">إعدادات المحاسبة</h4>
                                            <small class="text-muted">الحسابات المحاسبية</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <label for="prepaid_revenue_policy" class="o_light_label"/>
                                    <field name="prepaid_revenue_policy"/>
                                    <div class="row mt-3">
                                        <div class="col-6">
                                            <label for="prepaid_liability_account_id" class="o_light_label"/>
                                            <field name="prepaid_liability_account_id"/>
                                        </div>
                                        <div class="col-6">
                                            <label for="electricity_revenue_account_id" class="o_light_label"/>
                                            <field name="electricity_revenue_account_id"/>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-6">
                                            <label for="service_charge_revenue_account_id" class="o_light_label"/>
                                            <field name="service_charge_revenue_account_id"/>
                                        </div>
                                        <div class="col-6">
                                            <label for="prepaid_tax_account_id" class="o_light_label"/>
                                            <field name="prepaid_tax_account_id"/>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-6">
                                            <label for="debt_recovery_account_id" class="o_light_label"/>
                                            <field name="debt_recovery_account_id"/>
                                        </div>
                                        <div class="col-6">
                                            <label for="prepaid_receivable_account_id" class="o_light_label"/>
                                            <field name="prepaid_receivable_account_id"/>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <label for="prepaid_journal_id" class="o_light_label"/>
                                        <field name="prepaid_journal_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12 col-lg-6">
                            <div class="card o_settings_card">
                                <div class="card-header">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-money fa-2x text-danger me-3" title="استقطاع الديون"/>
                                        <div>
                                            <h4 class="mb-0">استقطاع الديون</h4>
                                            <small class="text-muted">خصم الديون من الشحنات</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="mt-2">
                                        <field name="enable_debt_recovery"/>
                                        <label for="enable_debt_recovery" class="ms-2"/>
                                    </div>
                                    <div class="mt-3" attrs="{'invisible': [('enable_debt_recovery', '=', False)]}">
                                        <label for="default_debt_policy_id" class="o_light_label"/>
                                        <field name="default_debt_policy_id"/>
                                    </div>
                                    <div class="mt-3" attrs="{'invisible': [('enable_debt_recovery', '=', False)]}">
                                        <label for="minimum_energy_percentage" class="o_light_label"/>
                                        <field name="minimum_energy_percentage"/>
                                        <div class="text-muted">أقل نسبة طاقة متبقية بعد الاستقطاع (%)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="card o_settings_card">
                                <div class="card-header">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-bell fa-2x text-purple me-3" title="الإشعارات"/>
                                        <div>
                                            <h4 class="mb-0">الإشعارات</h4>
                                            <small class="text-muted">تنبيهات العملاء</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="mt-2">
                                        <field name="enable_token_sms"/>
                                        <label for="enable_token_sms" class="ms-2"/>
                                        <div class="text-muted">إرسال رمز الشحن عبر SMS</div>
                                    </div>
                                    <div class="mt-3">
                                        <field name="enable_low_credit_alert"/>
                                        <label for="enable_low_credit_alert" class="ms-2"/>
                                    </div>
                                    <div class="mt-2" attrs="{'invisible': [('enable_low_credit_alert', '=', False)]}">
                                        <label for="low_credit_threshold" class="o_light_label"/>
                                        <field name="low_credit_threshold"/>
                                        <div class="text-muted">حد الرصيد المنخفض (kWh)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
