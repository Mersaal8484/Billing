          <div class="o-sheet-item o-sheet" t-on-click="(ev) =&gt; this.activateSheet(sheet.id, ev)" t-on-contextmenu.prevent="(ev) =&gt; this.onContextMenu(sheet.id, ev)" t-att-title="sheet.name" t-att-data-id="sheet.id" t-att-class="{active: sheet.id === env.model.getters.getActiveSheetId()}">
