            <field name="name">Service Charge Multi-Company Rule</field>
            <field name="model_id" ref="model_utility_service_charge"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('utility_core.group_utility_billing_manager')), (4, ref('utility_core.group_utility_collector')), (4, ref('utility_core.group_utility_auditor'))]"/>
            <field name="perm_read" eval="True"/>
