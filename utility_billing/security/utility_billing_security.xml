<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="utility_billing_adjustment_company_rule" model="ir.rule">
            <field name="name">تعديلات الفوترة حسب الشركة</field>
            <field name="model_id" ref="model_utility_billing_adjustment"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="utility_sale_order_org_scope_rule" model="ir.rule">
            <field name="name">Utility Sale Order Organizational Scope Rule</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)] if user._is_global_utility_scope() else (['|', ('account_id', '=', False), '|', ('account_id.area_id', 'in', user._get_effective_branch_ids()), ('account_id.region_id', 'in', user._get_effective_region_ids())] if (user._get_effective_branch_ids() or user._get_effective_region_ids()) else [('account_id', '=', False)])</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="utility_billing_adjustment_org_scope_rule" model="ir.rule">
            <field name="name">Billing Adjustment Organizational Scope Rule</field>
            <field name="model_id" ref="model_utility_billing_adjustment"/>
            <field name="domain_force">[(1, '=', 1)] if user._is_global_utility_scope() else (['|', ('customer_id.area_id', 'in', user._get_effective_branch_ids()), ('customer_id.region_id', 'in', user._get_effective_region_ids())] if (user._get_effective_branch_ids() or user._get_effective_region_ids()) else [('id', '=', False)])</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="utility_writeoff_org_scope_rule" model="ir.rule">
            <field name="name">Write-off Organizational Scope Rule</field>
            <field name="model_id" ref="model_utility_writeoff"/>
            <field name="domain_force">[(1, '=', 1)] if user._is_global_utility_scope() else (['|', ('sale_order_id.account_id.area_id', 'in', user._get_effective_branch_ids()), ('sale_order_id.account_id.region_id', 'in', user._get_effective_region_ids())] if (user._get_effective_branch_ids() or user._get_effective_region_ids()) else [('id', '=', False)])</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

