<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Route-based Record Rules for Sale Order (Billing) -->
        <record id="utility_sale_order_route_rule" model="ir.rule">
            <field name="name">Sale Order Route Access Rule</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">['|', ('route_id', '=', False), ('route_id', 'in', user.assigned_route_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('utility_core.group_utility_collector')), (4, ref('utility_core.group_utility_technician'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
