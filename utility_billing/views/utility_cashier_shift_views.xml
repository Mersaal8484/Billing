<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cashier_shift_tree" model="ir.ui.view">
        <field name="name">utility.cashier.shift.tree</field>
        <field name="model">utility.cashier.shift</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'verified'" decoration-warning="state == 'open'" decoration-info="state == 'closing'" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="cashier_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="state" widget="badge" decoration-success="state in ('closed', 'verified')" decoration-warning="state == 'open'" decoration-info="state == 'closing'"/>
                <field name="opening_balance" widget="monetary"/>
                <field name="total_collections" widget="monetary" string="إجمالي التحصيل"/>
                <field name="expected_balance" widget="monetary"/>
                <field name="closing_balance" widget="monetary"/>
                <field name="difference" widget="monetary" decoration-danger="difference &lt; 0" decoration-success="difference &gt; 0"/>
            </tree>
        </field>
    </record>

    <record id="view_cashier_shift_form" model="ir.ui.view">
        <field name="name">utility.cashier.shift.form</field>
        <field name="model">utility.cashier.shift</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" string="إغلاق" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'open')]}"/>
                    <button name="action_verify" string="تدقيق" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'closing')]}"/>
                    <button name="action_reopen" string="إعادة فتح" type="object" attrs="{'invisible': [('state', 'in', ('closed', 'verified'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closing,closed,verified"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="cashier_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_time" readonly="1"/>
                            <field name="end_time"/>
                        </group>
                    </group>
                    <group string="الملخص المالي" name="financial_summary">
                        <group>
                            <field name="opening_balance" widget="monetary"/>
                            <field name="total_collections" widget="monetary" string="إجمالي تحصيلات الفواتير"/>
                        </group>
                        <group>
                            <field name="expected_balance" widget="monetary"/>
                            <field name="closing_balance" widget="monetary" attrs="{'readonly': [('state', 'in', ('closed', 'verified'))]}"/>
                            <field name="difference" widget="monetary" class="oe_inline" decoration-danger="difference &lt; 0" decoration-success="difference &gt; 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="collections" string="تحصيلات الفواتير">
                            <field name="payment_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="utility_sale_order_id"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="utility_payment_method"/>
                                    <field name="date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ملاحظات" name="notes">
                            <field name="notes" placeholder="ملاحظات الوردية..."/>
                            <field name="closing_notes" placeholder="ملاحظات الإغلاق..." attrs="{'invisible': [('state', '=', 'open')]}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_cashier_shift_search" model="ir.ui.view">
        <field name="name">utility.cashier.shift.search</field>
        <field name="model">utility.cashier.shift</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="cashier_id"/>
                <filter name="open" string="مفتوحة" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="مغلقة" domain="[('state', '=', 'closed')]"/>
                <filter name="verified" string="مدققة" domain="[('state', '=', 'verified')]"/>
                <filter name="my_shifts" string="وردياتي" domain="[('cashier_id', '=', uid)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                    <filter name="group_cashier" string="الكاشير" context="{'group_by': 'cashier_id'}"/>
                    <filter name="group_date" string="التاريخ" context="{'group_by': 'start_time:day'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
