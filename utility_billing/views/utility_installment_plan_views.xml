<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_installment_plan_tree" model="ir.ui.view">
        <field name="name">utility.installment.plan.tree</field>
        <field name="model">utility.installment.plan</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="customer_id"/>
                <field name="amount_total" sum="الإجمالي"/>
                <field name="paid_amount" sum="المدفوع"/>
                <field name="remaining_amount" sum="المتبقي"/>
                <field name="installment_count"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_installment_plan_form" model="ir.ui.view">
        <field name="name">utility.installment.plan.form</field>
        <field name="model">utility.installment.plan</field>
        <field name="arch" type="xml">
            <form string="خطة تقسيط">
                <header>
                    <button name="action_generate_lines" type="object" string="توليد الأقساط" states="draft" class="btn-secondary"/>
                    <button name="action_activate" type="object" string="تفعيل" states="draft" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="إلغاء" states="draft,active" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,paid,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="الفاتورة">
                            <field name="sale_order_id" options="{'no_create': True}"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group string="الخطة">
                            <field name="amount_total" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="installment_count" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="start_date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="paid_amount" readonly="1"/>
                            <field name="remaining_amount" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الأقساط">
                            <field name="line_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree editable="bottom" decoration-danger="state == 'overdue'" decoration-success="state == 'paid'" decoration-warning="state == 'partial'">
                                    <field name="sequence"/>
                                    <field name="due_date"/>
                                    <field name="amount"/>
                                    <field name="paid_amount" readonly="1"/>
                                    <field name="remaining_amount" readonly="1"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_utility_installment_plan" model="ir.actions.act_window">
        <field name="name">خطط التقسيط</field>
        <field name="res_model">utility.installment.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_utility_installment_plan" name="خطط التقسيط" parent="utility_billing.menu_utility_billing" sequence="80" action="action_utility_installment_plan" active="False"/>
</odoo>