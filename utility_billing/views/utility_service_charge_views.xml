<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_service_charge_tree" model="ir.ui.view">
        <field name="name">utility.service.charge.tree</field>
        <field name="model">utility.service.charge</field>
        <field name="arch" type="xml">
            <tree default_order="date desc, id desc" decoration-success="state == 'paid'" decoration-warning="state in ('confirmed', 'payment_requested', 'deferred')" decoration-muted="state in ('cancelled', 'reversed')">
                <field name="name"/>
                <field name="date"/>
                <field name="service_order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="billing_method"/>
                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_service_charge_form" model="ir.ui.view">
        <field name="name">utility.service.charge.form</field>
        <field name="model">utility.service.charge</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="تأكيد" type="object" states="draft" class="btn-primary"/>
                    <button name="action_create_invoice" string="إنشاء فاتورة" type="object" states="confirmed" class="btn-primary" attrs="{'invisible': [('billing_method', '!=', 'invoice')]}"/>
                    <button name="action_open_direct_payment" string="فتح دفع مباشر" type="object" states="confirmed,payment_requested" class="btn-primary" attrs="{'invisible': [('billing_method', '!=', 'direct_payment')]}"/>
                    <button name="action_mark_paid_from_payment" string="تحديث السداد" type="object" states="invoiced,payment_requested" class="btn-secondary"/>
                    <button name="action_cancel" string="إلغاء" type="object" states="draft,confirmed,payment_requested,deferred" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,invoiced,payment_requested,paid"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="service_order_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="account_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="billing_method" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <field name="date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الرسم">
                            <group>
                                <group>
                                    <field name="product_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="description" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="quantity" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                </group>
                                <group>
                                    <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="tax_ids" widget="many2many_tags" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="المستندات المالية">
                            <group>
                                <field name="invoice_id" readonly="1"/>
                                <field name="payment_id" readonly="1"/>
                                <field name="pos_order_id" readonly="1"/>
                                <field name="billing_charge_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_utility_service_charge_search" model="ir.ui.view">
        <field name="name">utility.service.charge.search</field>
        <field name="model">utility.service.charge</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="service_order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="state"/>
                <filter name="filter_date" string="التاريخ" date="date"/>
                <filter name="filter_pending" string="بانتظار السداد" domain="[('state', 'in', ['confirmed', 'invoiced', 'payment_requested', 'deferred'])]"/>
                <filter name="filter_paid" string="مسدد" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="تصنيف حسب">
                    <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                    <filter name="group_billing_method" string="طريقة التحصيل" context="{'group_by': 'billing_method'}"/>
                    <filter name="group_service_order" string="أمر الخدمة" context="{'group_by': 'service_order_id'}"/>
                    <filter name="group_customer" string="العميل" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_company" string="الشركة" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_service_charge" model="ir.actions.act_window">
        <field name="name">رسوم الخدمات</field>
        <field name="res_model">utility.service.charge</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_utility_service_charge_search"/>
    </record>

    <menuitem id="menu_utility_service_charges" name="رسوم الخدمات"
              parent="utility_billing.menu_utility_accounting" sequence="35"
              action="action_utility_service_charge"/>
</odoo>
