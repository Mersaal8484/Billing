<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_service_order_form_inherit_billing" model="ir.ui.view">
        <field name="name">utility.service.order.form.inherit.billing</field>
        <field name="model">utility.service.order</field>
        <field name="inherit_id" ref="utility_operations.view_utility_service_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_create_service_charge" string="إنشاء رسم خدمة" type="object" states="approved,scheduled" class="btn-secondary" attrs="{'invisible': [('requires_financial_clearance', '=', False)]}"/>
                <button name="action_create_service_invoice" string="إنشاء فاتورة" type="object" states="approved,scheduled" class="btn-primary" attrs="{'invisible': ['|', ('requires_financial_clearance', '=', False), ('billing_method', '!=', 'invoice')]}"/>
                <button name="action_open_direct_payment" string="دفع مباشر" type="object" states="approved,scheduled" class="btn-primary" attrs="{'invisible': ['|', ('requires_financial_clearance', '=', False), ('billing_method', '!=', 'direct_payment')]}"/>
                <button name="action_add_to_next_bill" string="إضافة للفاتورة القادمة" type="object" states="approved,scheduled" class="btn-secondary" attrs="{'invisible': ['|', ('requires_financial_clearance', '=', False), ('billing_method', '!=', 'next_bill')]}"/>
                <button name="action_check_financial_clearance" string="فحص التسوية" type="object" states="approved,scheduled,in_progress" class="btn-secondary" attrs="{'invisible': [('requires_financial_clearance', '=', False)]}"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_service_charges" icon="fa-money">
                    <field string="رسوم الخدمة" name="service_charge_count" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" type="object" name="action_view_service_invoices" icon="fa-file-text-o">
                    <field string="الفواتير" name="invoice_count" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" type="object" name="action_view_service_payments" icon="fa-credit-card">
                    <field string="المدفوعات" name="payment_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//tree/field[@name='state']" position="after">
                <field name="financial_state" readonly="1"/>
            </xpath>
            <xpath expr="//notebook/page[@string='النتائج']" position="before">
                <page string="التسوية المالية">
                    <group>
                        <group>
                            <field name="billing_method" attrs="{'readonly': [('state', 'not in', ['draft', 'approved'])]}"/>
                            <field name="service_product_id" attrs="{'readonly': [('state', 'not in', ['draft', 'approved'])], 'required': [('requires_financial_clearance', '=', True)]}"/>
                            <field name="service_fee" widget="monetary" options="{'currency_field': 'company_currency_id'}" attrs="{'readonly': [('state', 'not in', ['draft', 'approved'])]}"/>
                        </group>
                        <group>
                            <field name="requires_financial_clearance" readonly="1"/>
                            <field name="financial_state" readonly="1"/>
                            <field name="financial_clearance_date" readonly="1"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="service_charge_ids" readonly="1">
                        <tree decoration-success="state == 'paid'" decoration-warning="state in ('confirmed', 'invoiced', 'payment_requested', 'deferred')" decoration-muted="state in ('cancelled', 'reversed')">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="product_id"/>
                            <field name="billing_method"/>
                            <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="invoice_id"/>
                            <field name="payment_id"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_utility_service_order_tree_inherit_billing" model="ir.ui.view">
        <field name="name">utility.service.order.tree.inherit.billing</field>
        <field name="model">utility.service.order</field>
        <field name="inherit_id" ref="utility_operations.view_utility_service_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='state']" position="after">
                <field name="billing_method"/>
                <field name="financial_state" widget="badge"/>
            </xpath>
        </field>
    </record>
</odoo>

