<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_bill_tree" model="ir.ui.view">
        <field name="name">utility.bill.tree</field>
        <field name="model">utility.bill</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_overdue==True" decoration-warning="state=='draft'">
                <field name="bill_number"/>
                <field name="customer_id"/>
                <field name="account_id"/>
                <field name="bill_date"/>
                <field name="due_date"/>
                <field name="consumption"/>
                <field name="amount_total"/>
                <field name="amount_paid"/>
                <field name="balance_due"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_bill_form" model="ir.ui.view">
        <field name="name">utility.bill.form</field>
        <field name="model">utility.bill</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="bill_number"/>
                            <field name="customer_id"/>
                            <field name="account_id"/>
                            <field name="meter_id"/>
                            <field name="billing_cycle_id"/>
                        </group>
                        <group>
                            <field name="bill_date"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="due_date"/>
                            <field name="tariff_id"/>
                        </group>
                    </group>
                    <group string="Reading Details">
                        <group>
                            <field name="previous_reading"/>
                            <field name="current_reading"/>
                        </group>
                        <group>
                            <field name="consumption"/>
                        </group>
                    </group>
                    <group string="Amounts">
                        <group>
                            <field name="amount_energy"/>
                            <field name="amount_fixed"/>
                            <field name="amount_service"/>
                            <field name="amount_tax"/>
                            <field name="amount_penalty"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="amount_paid"/>
                            <field name="balance_due"/>
                            <field name="is_overdue"/>
                        </group>
                    </group>
                    <field name="notes" nolabel="1"/>
                </sheet>
                <notebook>
                    <page name="lines" string="Bill Lines">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="quantity"/>
                                <field name="unit"/>
                                <field name="unit_price"/>
                                <field name="amount"/>
                                <field name="is_tax"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="view_utility_bill_search" model="ir.ui.view">
        <field name="name">utility.bill.search</field>
        <field name="model">utility.bill</field>
        <field name="arch" type="xml">
            <search>
                <field name="bill_number"/>
                <field name="customer_id"/>
                <field name="account_id"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_month" string="Bill Month" context="{'group_by':'bill_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_utility_bill" model="ir.actions.act_window">
        <field name="name">Bills</field>
        <field name="res_model">utility.bill</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_utility_bill_search"/>
    </record>
</odoo>
