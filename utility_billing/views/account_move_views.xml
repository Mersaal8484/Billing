<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_utility" model="ir.ui.view">
        <field name="name">account.move.form.inherit.utility</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="تفاصيل الكهرباء" attrs="{'invisible': [('utility_sale_order_id', '=', False), ('service_charge_id', '=', False)]}">
                    <group>
                        <group>
                            <field name="utility_sale_order_id" readonly="1" attrs="{'invisible': [('utility_sale_order_id', '=', False)]}"/>
                            <field name="service_charge_id" readonly="1" attrs="{'invisible': [('service_charge_id', '=', False)]}"/>
                            <field name="meter_number" readonly="1" attrs="{'invisible': [('utility_sale_order_id', '=', False)]}"/>
                        </group>
                        <group attrs="{'invisible': [('utility_sale_order_id', '=', False)]}">
                            <field name="current_meter_reading" readonly="1"/>
                            <field name="consumption_units" readonly="1"/>
                            <field name="consumption_alert" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
