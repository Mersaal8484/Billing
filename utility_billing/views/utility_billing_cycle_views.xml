<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_utility_billing_cycle_tree" model="ir.ui.view">
        <field name="name">utility.billing.cycle.tree</field>
        <field name="model">utility.billing.cycle</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="cycle_date"/>
                <field name="billing_period_start"/>
                <field name="billing_period_end"/>
                <field name="due_date"/>
                <field name="frequency"/>
                <field name="state"/>
                <field name="total_bills"/>
                <field name="total_amount"/>
            </tree>
        </field>
    </record>

    <record id="view_utility_billing_cycle_form" model="ir.ui.view">
        <field name="name">utility.billing.cycle.form</field>
        <field name="model">utility.billing.cycle</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="action_generate_bills" string="Generate Bills"
                            type="object" class="btn-primary"
                            states="open"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="frequency"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="region_id"/>
                            <field name="area_id"/>
                            <field name="total_bills"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <group string="Dates">
                        <group>
                            <field name="cycle_date"/>
                            <field name="billing_period_start"/>
                            <field name="billing_period_end"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="cutoff_date"/>
                        </group>
                    </group>
                    <field name="meter_ids" widget="many2many_tags"/>
                </sheet>
                <notebook>
                    <page name="bills" string="Bills">
                        <field name="bill_ids">
                            <tree>
                                <field name="bill_number"/>
                                <field name="customer_id"/>
                                <field name="account_id"/>
                                <field name="amount_total"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="action_utility_billing_cycle" model="ir.actions.act_window">
        <field name="name">Billing Cycles</field>
        <field name="res_model">utility.billing.cycle</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
