<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="view_utility_financial_settlement_tree" model="ir.ui.view">
        <field name="name">utility.financial.settlement.tree</field>
        <field name="model">utility.financial.settlement</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'applied'">
                <field name="name"/>
                <field name="account_id"/>
                <field name="customer_id"/>
                <field name="settlement_type"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_utility_financial_settlement_form" model="ir.ui.view">
        <field name="name">utility.financial.settlement.form</field>
        <field name="model">utility.financial.settlement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply_settlement" type="object"
                            string="تطبيق التسوية المالية" class="oe_highlight"
                            attrs="{'invisible': [('state', '=', 'applied')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,applied"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="رقم التسوية المالية"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="معلومات الحساب">
                            <field name="account_id"/>
                            <field name="customer_id"/>
                        </group>
                        <group string="تفاصيل الحركة المالية">
                            <field name="settlement_type"/>
                            <field name="amount"/>
                            <field name="date"/>
                            <field name="move_id" attrs="{'invisible': [('move_id', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="التفاصيل والسبب">
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_utility_financial_settlement" model="ir.actions.act_window">
        <field name="name">التسويات المالية للمشتركين</field>
        <field name="res_model">utility.financial.settlement</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_utility_financial_settlement" name="Financial Settlements"
              parent="utility_billing.menu_utility_accounting" sequence="40"
              action="action_utility_financial_settlement"/>
</odoo>
