<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_generate_recurring_invoices" model="ir.cron">
        <field name="name">ERP الكهرباء: توليد الفواتير المتكررة للعقود</field>
        <field name="model_id" ref="utility_core.model_utility_contract_template"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_recurring_invoices()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

