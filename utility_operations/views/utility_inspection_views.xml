<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_utility_inspection_tree" model="ir.ui.view">
            <field name="name">utility.inspection.tree</field>
            <field name="model">utility.inspection</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="inspection_type"/>
                    <field name="inspector_id"/>
                    <field name="inspection_date"/>
                    <field name="is_passed"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_utility_inspection_form" model="ir.ui.view">
            <field name="name">utility.inspection.form</field>
            <field name="model">utility.inspection</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_complete" type="object" string="إكمال المعاينة" class="btn-success" states="scheduled"/>
                        <button name="action_cancel" type="object" string="إلغاء المعاينة" class="btn-secondary" states="scheduled" confirm="هل أنت متاكد من إلغاء المعاينة؟"/>
                        <field name="state" widget="statusbar" statusbar_visible="scheduled,completed"/>
                    </header>
                    <sheet>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="service_order_id"/>
                                <field name="inspection_type" required="1"/>
                                <field name="inspector_id"/>
                            </group>
                            <group>
                                <field name="inspection_date"/>
                                <field name="state"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="customer_id"/>
                                <field name="account_id"/>
                                <field name="meter_id"/>
                            </group>
                            <group>
                                <field name="condition_rating"/>
                                <field name="is_passed"/>
                                <field name="address"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="النتائج">
                                <field name="findings" nolabel="1"/>
                            </page>
                            <page string="التوقيعات">
                                <group>
                                    <field name="customer_signature" widget="signature"/>
                                    <field name="inspector_signature" widget="signature"/>
                                </group>
                            </page>
                            <page string="ملاحظات">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_utility_inspection" model="ir.actions.act_window">
            <field name="name">المعاينات</field>
            <field name="res_model">utility.inspection</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
