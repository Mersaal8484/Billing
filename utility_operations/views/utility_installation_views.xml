<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_utility_installation_tree" model="ir.ui.view">
            <field name="name">utility.installation.tree</field>
            <field name="model">utility.installation</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="meter_id"/>
                    <field name="installation_date"/>
                    <field name="installer_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_utility_installation_form" model="ir.ui.view">
            <field name="name">utility.installation.form</field>
            <field name="model">utility.installation</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_install" type="object" string="تنفيذ التركيب" class="btn-primary" states="draft"/>
                        <button name="action_verify" type="object" string="التحقق من التركيب" class="btn-success" states="installed"/>
                        <button name="action_fail" type="object" string="تسجيل فشل" class="btn-danger" states="draft,installed" confirm="هل أنت متاكد من تسجيل فشل هذه التركيبة؟"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,installed,verified"/>
                    </header>
                    <sheet>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="service_order_id"/>
                                <field name="customer_id" required="1"/>
                                <field name="account_id" required="1"/>
                            </group>
                            <group>
                                <field name="installation_date"/>
                                <field name="installer_id"/>
                                <field name="state"/>
                            </group>
                        </group>
                        <group string="بيانات العداد">
                            <group>
                                <field name="meter_id" required="1"/>
                                <field name="meter_serial_snapshot" readonly="1"/>
                                <field name="meter_type_id"/>
                            </group>
                            <group>
                                <field name="seal_number"/>
                                <field name="address"/>
                            </group>
                        </group>
                        <field name="notes" nolabel="1"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_utility_installation" model="ir.actions.act_window">
            <field name="name">التركيبات</field>
            <field name="res_model">utility.installation</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
