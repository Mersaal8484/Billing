<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="view_utility_reading_settlement_tree" model="ir.ui.view">
        <field name="name">utility.reading.settlement.tree</field>
        <field name="model">utility.reading.settlement</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'done'">
                <field name="name"/>
                <field name="reading_id"/>
                <field name="meter_id"/>
                <field name="account_id"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <field name="adjusted_by"/>
                <field name="adjustment_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_utility_reading_settlement_form" model="ir.ui.view">
        <field name="name">utility.reading.settlement.form</field>
        <field name="model">utility.reading.settlement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply_settlement" type="object"
                            string="تطبيق التسوية" class="oe_highlight"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="رقم التسوية"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="معلومات القراءة">
                            <field name="reading_id"/>
                            <field name="meter_id"/>
                            <field name="account_id"/>
                        </group>
                        <group string="التسوية والتعديل">
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="adjusted_by"/>
                            <field name="adjustment_date"/>
                        </group>
                    </group>
                    <group string="تفاصيل إضافية">
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_utility_readings_settlement" model="ir.actions.act_window">
        <field name="name">تسوية قراءات العدادات</field>
        <field name="res_model">utility.reading.settlement</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
