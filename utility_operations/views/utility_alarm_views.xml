<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_utility_alarm_tree" model="ir.ui.view">
            <field name="name">utility.alarm.tree</field>
            <field name="model">utility.alarm</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="alarm_code"/>
                    <field name="alarm_date"/>
                    <field name="alarm_type"/>
                    <field name="severity"/>
                    <field name="customer_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_utility_alarm_form" model="ir.ui.view">
            <field name="name">utility.alarm.form</field>
            <field name="model">utility.alarm</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button name="action_acknowledge" string="تأكيد الاستلام" type="object"
                                states="open" class="btn-primary"/>
                        <button name="action_resolve" string="حل" type="object"
                                states="acknowledged,investigating" class="btn-primary"/>
                        <button name="action_close" string="إغلاق" type="object"
                                states="resolved" class="btn-primary"/>
                        <button name="action_create_service_order" string="إنشاء أمر خدمة / قضية تلاعب" type="object"
                                states="open,acknowledged,investigating" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <h1>
                            <field name="alarm_code" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="alarm_type" required="1"/>
                                <field name="severity"/>
                                <field name="alarm_date"/>
                            </group>
                            <group>
                                <field name="assigned_to"/>
                                <field name="customer_id"/>
                                <field name="account_id"/>
                                <field name="meter_id"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="region_id"/>
                                <field name="area_id"/>
                            </group>
                            <group>
                                <field name="meter_reading"/>
                                <field name="voltage"/>
                                <field name="current"/>
                                <field name="power"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="التفاصيل">
                                <group>
                                    <field name="description" nolabel="1"/>
                                </group>
                            </page>
                            <page string="الحل">
                                <group>
                                    <field name="resolution"/>
                                    <field name="resolution_date"/>
                                    <field name="service_order_id"/>
                                    <field name="tamper_case_id" attrs="{'invisible': [('alarm_type', '!=', 'tamper')]}"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_utility_alarm" model="ir.actions.act_window">
            <field name="name">الإنذارات</field>
            <field name="res_model">utility.alarm</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
