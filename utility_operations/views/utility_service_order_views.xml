<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_utility_service_order_tree" model="ir.ui.view">
            <field name="name">utility.service.order.tree</field>
            <field name="model">utility.service.order</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="order_number"/>
                    <field name="date_requested"/>
                    <field name="service_type"/>
                    <field name="priority"/>
                    <field name="customer_id"/>
                    <field name="meter_id"/>
                    <field name="technician_id"/>
                    <field name="state"/>
                    <field name="date_scheduled"/>
                </tree>
            </field>
        </record>

        <record id="view_utility_service_order_form" model="ir.ui.view">
            <field name="name">utility.service.order.form</field>
            <field name="model">utility.service.order</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button name="action_approve" string="Approve" type="object"
                                states="draft" class="btn-primary"/>
                        <button name="action_schedule" string="Schedule" type="object"
                                states="approved" class="btn-primary"/>
                        <button name="action_start" string="Start" type="object"
                                states="scheduled" class="btn-primary"/>
                        <button name="action_complete" string="Complete" type="object"
                                states="in_progress" class="btn-primary"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                states="draft,approved,scheduled" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <h1>
                            <field name="order_number" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="service_type" required="1"/>
                                <field name="priority"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="technician_id"/>
                                <field name="team_id"/>
                                <field name="date_requested"/>
                                <field name="date_scheduled"/>
                                <field name="date_completed"/>
                            </group>
                        </group>
                        <group>
                            <group string="Customer">
                                <field name="customer_id"/>
                                <field name="account_id"/>
                                <field name="meter_id"/>
                            </group>
                            <group string="Location">
                                <field name="region_id"/>
                                <field name="area_id"/>
                                <field name="zone_id"/>
                                <field name="office_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" nolabel="1"/>
                            </page>
                            <page string="Meter Info">
                                <group>
                                    <group string="Old Meter">
                                        <field name="old_meter_id"/>
                                        <field name="meter_reading_before"/>
                                        <field name="seal_number_old"/>
                                    </group>
                                    <group string="New Meter">
                                        <field name="new_meter_id"/>
                                        <field name="meter_reading_after"/>
                                        <field name="seal_number_new"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Results">
                                <group>
                                    <group>
                                        <field name="findings"/>
                                        <field name="tamper_evidence"/>
                                        <field name="tamper_notes"/>
                                    </group>
                                    <group>
                                        <field name="cost_estimate"/>
                                        <field name="actual_cost"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Notes">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_utility_service_order_search" model="ir.ui.view">
            <field name="name">utility.service.order.search</field>
            <field name="model">utility.service.order</field>
            <field name="arch" type="xml">
                <search>
                    <field name="order_number"/>
                    <field name="customer_id"/>
                    <field name="technician_id"/>
                    <field name="service_type"/>
                    <field name="state"/>
                    <field name="priority"/>
                    <filter name="filter_date" string="Date Requested" date="date_requested"/>
                    <group expand="0" string="Group By">
                        <filter name="group_service_type" string="Service Type" context="{'group_by': 'service_type'}"/>
                        <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                        <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                        <filter name="group_technician" string="Technician" context="{'group_by': 'technician_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_utility_service_order" model="ir.actions.act_window">
            <field name="name">Service Orders</field>
            <field name="res_model">utility.service.order</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_utility_service_order_search"/>
            <field name="help" type="html">
                <p>Manage service orders for utility field operations.</p>
            </field>
        </record>

    </data>
</odoo>
