<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="utility_service_order_demo_1" model="utility.service.order">
            <field name="order_number">SO000001</field>
            <field name="service_type">new_connection</field>
            <field name="priority">high</field>
            <field name="description">New connection for residential building at district 4. Requires 3-phase meter installation with underground cabling.</field>
            <field name="state">draft</field>
        </record>


        <record id="utility_tamper_case_demo_1" model="utility.tamper.case">
